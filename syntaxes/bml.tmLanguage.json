{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BlockML",
  "scopeName": "source.bml",
  "patterns": [
    { "include": "#comment" },
    { "include": "#expression" },
    { "include": "#embed" },
    { "include": "#tagRoot" },
    { "include": "#tagIdentity" },
    { "include": "#tagContainer" },
    { "include": "#tagFacet" },
    { "include": "#tag" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.bml",
      "begin": "<!--",
      "end": "-->",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.bml" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.bml" }
      }
    },
    "expression": {
      "name": "keyword.other.interpolation.bml",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.interpolation.begin.bml" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.interpolation.end.bml" }
      }
    },
    "embed": {
      "name": "keyword.control.embed.bml",
      "begin": "<\\$",
      "end": "\\$>",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.embed.begin.bml" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.embed.end.bml" }
      }
    },
    "stringDouble": {
      "name": "string.quoted.double.bml",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "include": "#expression" },
        { "include": "#embed" }
      ]
    },
    "stringSingle": {
      "name": "string.quoted.single.bml",
      "begin": "'",
      "end": "'",
      "patterns": [
        { "include": "#expression" },
        { "include": "#embed" }
      ]
    },
    "attribute": {
      "match": "\\s+([A-Za-z_:][\\w:.-]*)(\\s*=\\s*)(?:(\")([^\"]*)(\")|(')([^']*)('))?",
      "captures": {
        "1": { "name": "entity.other.attribute-name.bml" },
        "2": { "name": "punctuation.separator.key-value.bml" },
        "3": { "name": "punctuation.definition.string.begin.bml" },
        "4": { "name": "string.quoted.double.bml" },
        "5": { "name": "punctuation.definition.string.end.bml" },
        "6": { "name": "punctuation.definition.string.begin.bml" },
        "7": { "name": "string.quoted.single.bml" },
        "8": { "name": "punctuation.definition.string.end.bml" }
      }
    },
    "tagRoot": {
      "name": "meta.tag.bml",
      "begin": "(</?)(block)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.type.framework.root.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagIdentity": {
      "name": "meta.tag.bml",
      "begin": "(</?)(name|type|baseType|is|isnot|version|abstract|final|definition|language)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.definition.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagContainer": {
      "name": "meta.tag.bml",
      "begin": "(</?)(properties|aggregations|associations|capabilities|constraints|contracts|subBlocks|embeddedBlocks|composition|genericTypes|groups|aliases|keywords|references|blocks|readMe|library)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "meta.tag.framework.container.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagFacet": {
      "name": "meta.tag.bml",
      "begin": "(</?)(value|documentation|summary|implementation|inputType|outputType|suggestions|override|readOnly|visibility|status|since|changelog|examples|relation|see|content|default|description|title|bml:xml|bml:container)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "support.type.framework.facet.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tag": {
      "name": "meta.tag.bml",
      "begin": "(</?)(([A-Za-z_:][\\w:.-]*))",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.tag.bml" },
        "3": { "name": "entity.name.tag.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    }
  }
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BlockML",
  "scopeName": "source.bml",
  "patterns": [
    { "include": "#comment" },
    { "include": "#expression" },
    { "include": "#embed" },
    { "include": "#block" },
    { "include": "#tagRoot" },
    { "include": "#tagBlockDeclaration" },
    { "include": "#tagBlockFacet" },
    { "include": "#tagBlockContainer" },
    { "include": "#tagMemberContainer" },
    { "include": "#tagDomainType" },
    { "include": "#tag" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.bml",
      "begin": "<!--",
      "end": "-->",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.bml" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.bml" }
      }
    },
    "expression": {
      "name": "keyword.other.interpolation.bml",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.interpolation.begin.bml" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.interpolation.end.bml" }
      }
    },
    "embed": {
      "name": "keyword.control.embed.bml",
      "begin": "<\\$",
      "end": "\\$>",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.embed.begin.bml" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.embed.end.bml" }
      }
    },
    "attribute": {
      "match": "\\s+([A-Za-z_:][\\w:.-]*)(\\s*=\\s*)(?:(\")([^\"]*)(\")|(')([^']*)('))?",
      "captures": {
        "1": { "name": "entity.other.attribute-name.bml" },
        "2": { "name": "punctuation.separator.key-value.bml" },
        "3": { "name": "punctuation.definition.string.begin.bml" },
        "4": { "name": "string.quoted.double.bml" },
        "5": { "name": "punctuation.definition.string.end.bml" },
        "6": { "name": "punctuation.definition.string.begin.bml" },
        "7": { "name": "string.quoted.single.bml" },
        "8": { "name": "punctuation.definition.string.end.bml" }
      }
    },
    "block": {
      "name": "meta.block.bml",
      "begin": "(<)(block)(?=[\\s/>])",
      "end": "(/>)|(</)(block)\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.type.framework.root.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "punctuation.definition.tag.bml" },
        "3": { "name": "entity.name.type.framework.root.bml" },
        "4": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" },
        { "include": "#blockBody" }
      ]
    },
    "blockBody": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#expression" },
        { "include": "#embed" },
        { "include": "#tagBlockDeclarationElement" },
        { "include": "#tagBlockFacetElement" },
        { "include": "#tagMemberContainerElement" },
        { "include": "#tagBlockContainerElement" },
        { "include": "#block" },
        { "include": "#domainTypeElement" },
        { "include": "#memberElement" }
      ]
    },
    "memberBody": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#expression" },
        { "include": "#embed" },
        { "include": "#tagMemberFieldIdentityElement" },
        { "include": "#tagMemberFieldFacetElement" },
        { "include": "#tagMemberSubContainerElement" },
        { "include": "#domainTypeElement" },
        { "include": "#genericElement" }
      ]
    },
    "memberContainerBody": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#expression" },
        { "include": "#embed" },
        { "include": "#memberTypeElement" },
        { "include": "#memberElement" }
      ]
    },
    "blockContainerBody": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#expression" },
        { "include": "#embed" },
        { "include": "#blockBody" }
      ]
    },
    "memberSubContainerBody": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#expression" },
        { "include": "#embed" },
        { "include": "#memberBody" },
        { "include": "#compositionInstanceElement" },
        { "include": "#genericElement" }
      ]
    },
    "memberTypeElement": {
      "name": "meta.tag.bml",
      "begin": "(<)((?:[A-Za-z_][\\w.-]*:)?[A-Z][a-zA-Z0-9]*)(?=[\\s/>])",
      "end": "(/>)|(</)(\\2)\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.member.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "punctuation.definition.tag.bml" },
        "3": { "name": "entity.name.member.bml" },
        "4": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" },
        { "include": "#memberBody" }
      ]
    },
    "memberElement": {
      "name": "meta.tag.bml",
      "begin": "(<)((?:[A-Za-z_][\\w.-]*:)?[a-z_][\\w.-]*)(?=[\\s/>])",
      "end": "(/>)|(</)(\\2)\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.member.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "punctuation.definition.tag.bml" },
        "3": { "name": "entity.name.member.bml" },
        "4": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" },
        { "include": "#memberBody" }
      ]
    },
    "domainTypeElement": {
      "name": "meta.tag.bml",
      "begin": "(<)((?:[A-Za-z_][\\w.-]*:)?[A-Z][a-zA-Z0-9]*)(?=[\\s/>])",
      "end": "(/>)|(</)(\\2)\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.type.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "punctuation.definition.tag.bml" },
        "3": { "name": "entity.name.type.bml" },
        "4": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" },
        { "include": "#memberBody" }
      ]
    },
    "compositionInstanceElement": {
      "name": "meta.tag.bml",
      "begin": "(<)((?:[A-Za-z_][\\w.-]*:)?[A-Z][a-zA-Z0-9]*)(?=[\\s/>])",
      "end": "(/>)|(</)(\\2)\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.type.instance.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "punctuation.definition.tag.bml" },
        "3": { "name": "entity.name.type.instance.bml" },
        "4": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" },
        { "include": "#memberBody" }
      ]
    },
    "genericElement": {
      "name": "meta.tag.bml",
      "begin": "(<)((?:[A-Za-z_][\\w.-]*:)?[a-z_][\\w.-]*)(?=[\\s/>])",
      "end": "(/>)|(</)(\\2)\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.tag.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "punctuation.definition.tag.bml" },
        "3": { "name": "entity.name.tag.bml" },
        "4": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagBlockDeclarationElement": {
      "name": "meta.tag.bml",
      "begin": "(<)(name|type|baseType|is|isnot|version|abstract|final|definition|language)(?=[\\s/>])",
      "end": "(/>)|(</)(\\2)\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.block-declaration.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "punctuation.definition.tag.bml" },
        "3": { "name": "keyword.other.block-declaration.bml" },
        "4": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagBlockFacetElement": {
      "name": "meta.tag.bml",
      "begin": "(<)(documentation|summary|status|since|changelog|examples|relation|see|content|description|title|bml:xml|bml:container|implementation)(?=[\\s/>])",
      "end": "(/>)|(</)(\\2)\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "support.type.block-facet.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "punctuation.definition.tag.bml" },
        "3": { "name": "support.type.block-facet.bml" },
        "4": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagMemberFieldIdentityElement": {
      "name": "meta.tag.bml",
      "begin": "(<)(type|abstract|final|override|readOnly|visibility|default)(?=[\\s/>])",
      "end": "(/>)|(</)(\\2)\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.member-field.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "punctuation.definition.tag.bml" },
        "3": { "name": "keyword.other.member-field.bml" },
        "4": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagMemberFieldFacetElement": {
      "name": "meta.tag.bml",
      "begin": "(<)(value|documentation|summary|implementation|inputType|outputType|status|since|changelog|examples|relation|see|content|description|title|bml:xml|bml:container)(?=[\\s/>])",
      "end": "(/>)|(</)(\\2)\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "support.type.member-facet.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "punctuation.definition.tag.bml" },
        "3": { "name": "support.type.member-facet.bml" },
        "4": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagMemberContainerElement": {
      "name": "meta.member-container.bml",
      "begin": "(<)(properties|aggregations|associations|capabilities|constraints)(?=[\\s/>])",
      "end": "(/>)|(</)(\\2)\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.member-container.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "punctuation.definition.tag.bml" },
        "3": { "name": "keyword.other.member-container.bml" },
        "4": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" },
        { "include": "#memberContainerBody" }
      ]
    },
    "tagBlockContainerElement": {
      "name": "meta.block-container.bml",
      "begin": "(<)(contracts|subBlocks|embeddedBlocks|composition|genericTypes|groups|aliases|keywords|references)(?=[\\s/>])",
      "end": "(/>)|(</)(\\2)\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.block-container.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "punctuation.definition.tag.bml" },
        "3": { "name": "keyword.other.block-container.bml" },
        "4": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" },
        { "include": "#blockContainerBody" }
      ]
    },
    "tagMemberSubContainerElement": {
      "name": "meta.member-subcontainer.bml",
      "begin": "(<)(suggestions|composition|constraints|groups|implementation)(?=[\\s/>])",
      "end": "(/>)|(</)(\\2)\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.member-subcontainer.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "punctuation.definition.tag.bml" },
        "3": { "name": "keyword.other.member-subcontainer.bml" },
        "4": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" },
        { "include": "#memberSubContainerBody" }
      ]
    },
    "tagRoot": {
      "name": "meta.tag.bml",
      "begin": "(</?)(block)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.type.framework.root.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagBlockDeclaration": {
      "name": "meta.tag.bml",
      "begin": "(</?)(name|type|baseType|is|isnot|version|abstract|final|definition|language)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.block-declaration.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagBlockFacet": {
      "name": "meta.tag.bml",
      "begin": "(</?)(documentation|summary|status|since|changelog|examples|relation|see|content|description|title|bml:xml|bml:container|implementation)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "support.type.block-facet.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagBlockContainer": {
      "name": "meta.tag.bml",
      "begin": "(</?)(contracts|subBlocks|embeddedBlocks|composition|genericTypes|groups|aliases|keywords|references)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.block-container.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagMemberContainer": {
      "name": "meta.tag.bml",
      "begin": "(</?)(properties|aggregations|associations|capabilities|constraints)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.member-container.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagDomainType": {
      "name": "meta.tag.bml",
      "begin": "(</?)((?:[A-Za-z_][\\w.-]*:)?[A-Z][a-zA-Z0-9]*)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.type.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tag": {
      "name": "meta.tag.bml",
      "begin": "(</?)((?:[A-Za-z_][\\w.-]*:)?[a-z_][\\w.-]*)",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.tag.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    }
  }
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BlockML",
  "scopeName": "source.bml",
  "patterns": [
    { "include": "#comment" },
    { "include": "#expression" },
    { "include": "#embed" },
    { "include": "#block" },
    { "include": "#tagRoot" },
    { "include": "#tagIdentity" },
    { "include": "#tagBlockContainer" },
    { "include": "#tagMemberContainer" },
    { "include": "#tagFacet" },
    { "include": "#tagDomainType" },
    { "include": "#tag" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.bml",
      "begin": "<!--",
      "end": "-->",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.bml" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.bml" }
      }
    },
    "expression": {
      "name": "keyword.other.interpolation.bml",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.interpolation.begin.bml" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.interpolation.end.bml" }
      }
    },
    "embed": {
      "name": "keyword.control.embed.bml",
      "begin": "<\\$",
      "end": "\\$>",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.embed.begin.bml" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.embed.end.bml" }
      }
    },
    "stringDouble": {
      "name": "string.quoted.double.bml",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "include": "#expression" },
        { "include": "#embed" }
      ]
    },
    "stringSingle": {
      "name": "string.quoted.single.bml",
      "begin": "'",
      "end": "'",
      "patterns": [
        { "include": "#expression" },
        { "include": "#embed" }
      ]
    },
    "attribute": {
      "match": "\\s+([A-Za-z_:][\\w:.-]*)(\\s*=\\s*)(?:(\")([^\"]*)(\")|(')([^']*)('))?",
      "captures": {
        "1": { "name": "entity.other.attribute-name.bml" },
        "2": { "name": "punctuation.separator.key-value.bml" },
        "3": { "name": "punctuation.definition.string.begin.bml" },
        "4": { "name": "string.quoted.double.bml" },
        "5": { "name": "punctuation.definition.string.end.bml" },
        "6": { "name": "punctuation.definition.string.begin.bml" },
        "7": { "name": "string.quoted.single.bml" },
        "8": { "name": "punctuation.definition.string.end.bml" }
      }
    },
    "block": {
      "name": "meta.tag.bml",
      "begin": "(<)(block)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.type.framework.root.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" },
        {
          "begin": ">",
          "end": "(?=</block>)",
          "patterns": [
            { "include": "#blockBody" }
          ]
        }
      ]
    },
    "blockBody": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#expression" },
        { "include": "#embed" },
        { "include": "#closeTagBlock" },
        { "include": "#closeTagDomainType" },
        { "include": "#tagIdentityElement" },
        { "include": "#tagMemberContainerElement" },
        { "include": "#tagBlockContainerElement" },
        { "include": "#tagFacetElement" },
        { "include": "#block" },
        { "include": "#domainTypeElement" },
        { "include": "#genericElement" }
      ]
    },
    "memberBody": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#expression" },
        { "include": "#embed" },
        { "include": "#closeTagMemberField" },
        { "include": "#closeTagDomainType" },
        { "include": "#tagIdentityElement" },
        { "include": "#tagFacetElement" },
        { "include": "#tagMemberSubContainerElement" },
        { "include": "#domainTypeElement" },
        { "include": "#genericElement" }
      ]
    },
    "memberContainerBody": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#expression" },
        { "include": "#embed" },
        { "include": "#closeTagMemberContainer" },
        { "include": "#memberTypeElement" },
        { "include": "#memberElement" }
      ]
    },
    "blockContainerBody": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#expression" },
        { "include": "#embed" },
        { "include": "#closeTagBlockContainer" },
        { "include": "#blockBody" }
      ]
    },
    "memberSubContainerBody": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#expression" },
        { "include": "#embed" },
        { "include": "#closeTagMemberSubContainer" },
        { "include": "#memberBody" },
        { "include": "#domainTypeElement" },
        { "include": "#genericElement" }
      ]
    },
    "memberTypeElement": {
      "name": "meta.tag.bml",
      "begin": "(<)((?:[A-Za-z_][\\w.-]*:)?[A-Z][a-zA-Z0-9]*)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.type.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" },
        {
          "begin": ">",
          "end": "(?=</\\2>)",
          "patterns": [
            { "include": "#memberBody" }
          ]
        }
      ]
    },
    "memberElement": {
      "name": "meta.tag.bml",
      "begin": "(<)((?:[A-Za-z_][\\w.-]*:)?[a-z_][\\w.-]*)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.tag.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" },
        {
          "begin": ">",
          "end": "(?=</\\2>)",
          "patterns": [
            { "include": "#memberBody" }
          ]
        }
      ]
    },
    "domainTypeElement": {
      "name": "meta.tag.bml",
      "begin": "(<)((?:[A-Za-z_][\\w.-]*:)?[A-Z][a-zA-Z0-9]*)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.type.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "genericElement": {
      "name": "meta.tag.bml",
      "begin": "(<)((?:[A-Za-z_][\\w.-]*:)?[a-z_][\\w.-]*)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.tag.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagIdentityElement": {
      "name": "meta.tag.bml",
      "begin": "(<)(name|type|baseType|is|isnot|version|abstract|final|definition|language)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.definition.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagFacetElement": {
      "name": "meta.tag.bml",
      "begin": "(<)(value|documentation|summary|implementation|inputType|outputType|override|readOnly|visibility|status|since|changelog|examples|relation|see|content|default|description|title|bml:xml|bml:container)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "support.type.framework.facet.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagMemberContainerElement": {
      "name": "meta.tag.bml",
      "begin": "(<)(properties|aggregations|associations|capabilities|constraints)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.container.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" },
        {
          "begin": ">",
          "end": "(?=</(?:properties|aggregations|associations|capabilities|constraints)>)",
          "patterns": [
            { "include": "#memberContainerBody" }
          ]
        }
      ]
    },
    "tagBlockContainerElement": {
      "name": "meta.tag.bml",
      "begin": "(<)(contracts|subBlocks|embeddedBlocks|composition|genericTypes|groups|aliases|keywords|references|blocks|readMe|library)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.container.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" },
        {
          "begin": ">",
          "end": "(?=</(?:contracts|subBlocks|embeddedBlocks|composition|genericTypes|groups|aliases|keywords|references|blocks|readMe|library)>)",
          "patterns": [
            { "include": "#blockContainerBody" }
          ]
        }
      ]
    },
    "tagMemberSubContainerElement": {
      "name": "meta.tag.bml",
      "begin": "(<)(suggestions|composition|constraints|groups|implementation)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.container.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" },
        {
          "begin": ">",
          "end": "(?=</(?:suggestions|composition|constraints|groups|implementation)>)",
          "patterns": [
            { "include": "#memberSubContainerBody" }
          ]
        }
      ]
    },
    "closeTagDomainType": {
      "match": "(</)((?:[A-Za-z_][\\w.-]*:)?[A-Z][a-zA-Z0-9]*)(\\s*(>))",
      "captures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.type.bml" },
        "3": { "name": "punctuation.definition.tag.bml" }
      }
    },
    "closeTagBlock": {
      "match": "(</)(block)(\\s*(>))",
      "captures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.type.framework.root.bml" },
        "3": { "name": "punctuation.definition.tag.bml" }
      }
    },
    "closeTagMemberContainer": {
      "match": "(</)(properties|aggregations|associations|capabilities|constraints)(\\s*(>))",
      "captures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.container.bml" },
        "3": { "name": "punctuation.definition.tag.bml" }
      }
    },
    "closeTagBlockContainer": {
      "match": "(</)(contracts|subBlocks|embeddedBlocks|composition|genericTypes|groups|aliases|keywords|references|blocks|readMe|library)(\\s*(>))",
      "captures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.container.bml" },
        "3": { "name": "punctuation.definition.tag.bml" }
      }
    },
    "closeTagMemberSubContainer": {
      "match": "(</)(suggestions|composition|constraints|groups|implementation)(\\s*(>))",
      "captures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.container.bml" },
        "3": { "name": "punctuation.definition.tag.bml" }
      }
    },
    "closeTagMemberField": {
      "patterns": [
        {
          "match": "(</)(name|type|baseType|is|isnot|version|abstract|final|definition|language)(\\s*(>))",
          "captures": {
            "1": { "name": "punctuation.definition.tag.bml" },
            "2": { "name": "keyword.other.definition.bml" },
            "3": { "name": "punctuation.definition.tag.bml" }
          }
        },
        {
          "match": "(</)(value|documentation|summary|implementation|inputType|outputType|override|readOnly|visibility|status|since|changelog|examples|relation|see|content|default|description|title|bml:xml|bml:container)(\\s*(>))",
          "captures": {
            "1": { "name": "punctuation.definition.tag.bml" },
            "2": { "name": "support.type.framework.facet.bml" },
            "3": { "name": "punctuation.definition.tag.bml" }
          }
        }
      ]
    },
    "tagRoot": {
      "name": "meta.tag.bml",
      "begin": "(</?)(block)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.type.framework.root.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagIdentity": {
      "name": "meta.tag.bml",
      "begin": "(</?)(name|type|baseType|is|isnot|version|abstract|final|definition|language)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.definition.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagBlockContainer": {
      "name": "meta.tag.bml",
      "begin": "(</?)(contracts|subBlocks|embeddedBlocks|composition|genericTypes|groups|aliases|keywords|references|blocks|readMe|library)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.container.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagMemberContainer": {
      "name": "meta.tag.bml",
      "begin": "(</?)(properties|aggregations|associations|capabilities|constraints)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "keyword.other.container.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagFacet": {
      "name": "meta.tag.bml",
      "begin": "(</?)(value|documentation|summary|implementation|inputType|outputType|override|readOnly|visibility|status|since|changelog|examples|relation|see|content|default|description|title|bml:xml|bml:container)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "support.type.framework.facet.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tagDomainType": {
      "name": "meta.tag.bml",
      "begin": "(</?)((?:[A-Za-z_][\\w.-]*:)?[A-Z][a-zA-Z0-9]*)(?=[\\s/>])",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.type.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tag": {
      "name": "meta.tag.bml",
      "begin": "(</?)((?:[A-Za-z_][\\w.-]*:)?[a-z_][\\w.-]*)",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" },
        "2": { "name": "entity.name.tag.bml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    }
  }
}

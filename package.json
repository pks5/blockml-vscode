{
  "name": "blockml",
  "version": "0.1.0",
  "description": "V1 language support for BlockML (BML) — limited syntax highlighting (no language server yet), BlockML color theme, and file icons. A language server is planned for V2.",
  "displayName": "BlockML",
  "publisher": "blockml",
  "license": "Apache-2.0",
  "icon": "icons/blockml.png",

  "repository": {
    "type": "git",
    "url": "https://github.com/pks5/blockml-vscode.git"
  },

  "engines": {
    "vscode": "^1.85.0"
  },

  "categories": [
    "Programming Languages",
    "Themes"
  ],

  "keywords": [
    "blockml",
    "bml",
    "syntax highlighting",
    "language"
  ],

  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },

  "homepage": "https://github.com/pks5/blockml-vscode",

  "bugs": {
    "url": "https://github.com/pks5/blockml-vscode/issues"
  },

  "blockml": {
    "library": "./blocks/org/blockml/bml/vscode/Library.bml"
  },

  "contributes": {
    "languages": [
      {
        "id": "bml",
        "aliases": [
          "BlockML",
          "BML"
        ],
        "extensions": [
          ".bml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bml",
        "scopeName": "source.bml",
        "path": "./syntaxes/bml.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "blockml-icons",
        "label": "BlockML Icons",
        "path": "./icons/blockml-icon-theme.json"
      }
    ],
    "themes": [
      {
        "id": "blockml",
        "label": "BlockML",
        "uiTheme": "vs-dark",
        "path": "./themes/blockml-color-theme.json"
      }
    ],
    "configuration": {
      "title": "BlockML",
      "properties": {
        "blockml.bml.trace.server": {
          "type": "string",
          "default": "off",
          "description": "Traces the communication between VS Code and the BlockML language server (V2).",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "scope": "window"
        },
        "blockml.bml.enableLanguageServer": {
          "type": "boolean",
          "default": true,
          "description": "Enable the BlockML language server client (V2). Ignored until the V2 milestone is shipped.",
          "scope": "window"
        },
        "blockml.bml.enableSemanticHighlighting": {
          "type": "boolean",
          "default": true,
          "description": "Enable LSP semantic highlighting on top of the TextMate grammar (V2).",
          "scope": "window"
        }
      }
    }
  },

  "files": [
    "icons",
    "syntaxes",
    "themes",
    "language-configuration.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],

  "publishConfig": {
    "access": "public"
  },

  "scripts": {
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },

  "devDependencies": {
    "@blockml/core": "^1.0.2"
  }
}

{
  "name": "blockml",
  "version": "0.2.0",
  "description": "Language support for BlockML (BML) — syntax highlighting, diagnostics via language server, BlockML color theme, and file icons.",
  "displayName": "BlockML",
  "publisher": "blockml",
  "license": "Apache-2.0",
  "icon": "icons/blockml.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:bml",
    "workspaceContains:**/*.bml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pks5/blockml-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "keywords": [
    "blockml",
    "bml",
    "syntax highlighting",
    "language",
    "language server",
    "diagnostics"
  ],
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "homepage": "https://github.com/pks5/blockml-vscode",
  "bugs": {
    "url": "https://github.com/pks5/blockml-vscode/issues"
  },
  "blockml": {
    "library": "./blocks/org/blockml/bml/vscode/Library.bml"
  },
  "contributes": {
    "languages": [
      {
        "id": "bml",
        "aliases": [
          "BlockML",
          "BML"
        ],
        "extensions": [
          ".bml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bml",
        "scopeName": "source.bml",
        "path": "./syntaxes/bml.tmLanguage.json"
      }
    ],
    "xmlLanguageParticipants": [
      {
        "languageId": "bml"
      }
    ],
    "iconThemes": [
      {
        "id": "blockml-icons",
        "label": "BlockML Icons",
        "path": "./icons/blockml-icon-theme.json"
      }
    ],
    "themes": [
      {
        "id": "blockml",
        "label": "BlockML",
        "uiTheme": "vs-dark",
        "path": "./themes/blockml-color-theme.json"
      }
    ],
    "configuration": {
      "title": "BlockML",
      "properties": {
        "blockml.bml.trace.server": {
          "type": "string",
          "default": "off",
          "description": "Traces the communication between VS Code and the BlockML language server.",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "scope": "window"
        },
        "blockml.bml.enableLanguageServer": {
          "type": "boolean",
          "default": true,
          "description": "Enable the BlockML language server client for diagnostics.",
          "scope": "window"
        },
        "blockml.bml.enableSemanticHighlighting": {
          "type": "boolean",
          "default": true,
          "description": "Enable LSP semantic highlighting on top of the TextMate grammar (V2).",
          "scope": "window"
        }
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npx --yes @vscode/vsce package"
  },
  "dependencies": {
    "@blockml/lsp": "^0.1.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@blockml/core": "^1.0.3",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0"
  }
}

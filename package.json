{
  "name": "blockml",
  "version": "0.9.0",
  "description": "Language support for BlockML (BML) — syntax highlighting, diagnostics via language server, and file icons.",
  "displayName": "BlockML",
  "publisher": "blockml",
  "license": "Apache-2.0",
  "icon": "icons/blockml.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:bml",
    "workspaceContains:**/*.bml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pks5/blockml-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "blockml",
    "bml",
    "syntax highlighting",
    "language",
    "language server",
    "diagnostics"
  ],
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "homepage": "https://github.com/pks5/blockml-vscode",
  "bugs": {
    "url": "https://github.com/pks5/blockml-vscode/issues"
  },
  "blockml": {
    "library": "./blocks/org/blockml/bml/vscode/Library.bml"
  },
  "contributes": {
    "languages": [
      {
        "id": "bml",
        "aliases": [
          "BlockML",
          "BML"
        ],
        "extensions": [
          ".bml"
        ],
        "icon": {
          "light": "./icons/blockml.svg",
          "dark": "./icons/blockml.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bml",
        "scopeName": "source.bml",
        "path": "./syntaxes/bml.tmLanguage.json"
      }
    ],
    "xmlLanguageParticipants": [
      {
        "languageId": "bml"
      }
    ],
    "semanticTokenTypes": [
      { "id": "root", "description": "BML L0 block root", "superType": "class" },
      { "id": "blockDeclaration", "description": "BML L1 block declaration (name, type, abstract, …)", "superType": "keyword" },
      { "id": "blockFacet", "description": "BML L1 block facet (documentation, summary, …)", "superType": "type" },
      { "id": "blockContainer", "description": "BML L1 block container (subBlocks, references, …)", "superType": "keyword" },
      { "id": "memberContainer", "description": "BML L1 member container (properties, aggregations, …)", "superType": "keyword" },
      { "id": "memberName", "description": "BML L2 member name", "superType": "property" },
      { "id": "memberField", "description": "BML L3 member field identity (type, override, …)", "superType": "keyword" },
      { "id": "memberFacet", "description": "BML L3 member field facet (documentation, value, …)", "superType": "type" },
      { "id": "memberSubContainer", "description": "BML L3 member sub-container (composition, …)", "superType": "keyword" },
      { "id": "domainType", "description": "BML domain type ref (PascalCase at block level)", "superType": "type" },
      { "id": "compositionInstance", "description": "BML L4 composition instance", "superType": "class" },
      { "id": "tag", "description": "BML fallback tag", "superType": "type" },
      { "id": "attribute", "description": "BML attribute name", "superType": "property" },
      { "id": "stringDouble", "description": "BML double-quoted string", "superType": "string" },
      { "id": "stringSingle", "description": "BML single-quoted string", "superType": "string" },
      { "id": "blockComment", "description": "BML block comment", "superType": "comment" },
      { "id": "interpolation", "description": "BML ${} interpolation", "superType": "keyword" },
      { "id": "embed", "description": "BML <$ $> embed marker", "superType": "keyword" },
      { "id": "tagPunctuation", "description": "BML tag punctuation" },
      { "id": "commentPunctuation", "description": "BML comment punctuation", "superType": "comment" },
      { "id": "attributeSeparator", "description": "BML attribute =" }
    ],
    "semanticTokenScopes": [
      {
        "language": "bml",
        "scopes": {
          "root": ["entity.name.type.framework.root.bml"],
          "blockDeclaration": ["keyword.other.block-declaration.bml"],
          "blockFacet": ["support.type.block-facet.bml"],
          "blockContainer": ["keyword.other.block-container.bml"],
          "memberContainer": ["keyword.other.member-container.bml"],
          "memberName": ["entity.name.member.bml"],
          "memberField": ["keyword.other.member-field.bml"],
          "memberFacet": ["support.type.member-facet.bml"],
          "memberSubContainer": ["keyword.other.member-subcontainer.bml"],
          "domainType": ["entity.name.type.bml"],
          "compositionInstance": ["entity.name.type.instance.bml"],
          "tag": ["entity.name.tag.bml"],
          "attribute": ["entity.other.attribute-name.bml"],
          "stringDouble": ["string.quoted.double.bml"],
          "stringSingle": ["string.quoted.single.bml"],
          "blockComment": ["comment.block.bml"],
          "interpolation": ["keyword.other.interpolation.bml"],
          "embed": ["keyword.control.embed.bml"],
          "tagPunctuation": ["punctuation.definition.tag.bml"],
          "commentPunctuation": ["punctuation.definition.comment.bml"],
          "attributeSeparator": ["punctuation.separator.key-value.bml"]
        }
      }
    ],
    "configurationDefaults": {
      "[bml]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "root:bml": { "foreground": "#FF79C6", "bold": true },
          "blockDeclaration:bml": { "foreground": "#C586C0" },
          "blockFacet:bml": { "foreground": "#6A9955" },
          "blockContainer:bml": { "foreground": "#3794FF" },
          "memberContainer:bml": { "foreground": "#4EC9B0", "bold": true },
          "memberName:bml": { "foreground": "#CE9178" },
          "memberField:bml": { "foreground": "#BB86FC" },
          "memberFacet:bml": { "foreground": "#98C379" },
          "memberSubContainer:bml": { "foreground": "#56B6C2" },
          "domainType:bml": { "foreground": "#DCDCAA" },
          "compositionInstance:bml": { "foreground": "#E5C07B" },
          "tag:bml": { "foreground": "#ABB2BF" },
          "attribute:bml": { "foreground": "#9CDCFE" },
          "stringDouble:bml": { "foreground": "#CE9178" },
          "stringSingle:bml": { "foreground": "#D7BA7D" },
          "blockComment:bml": { "foreground": "#608B4E" },
          "interpolation:bml": { "foreground": "#D7BA7D" },
          "embed:bml": { "foreground": "#D16969" },
          "tagPunctuation:bml": { "foreground": "#808080" },
          "commentPunctuation:bml": { "foreground": "#608B4E" },
          "attributeSeparator:bml": { "foreground": "#D4D4D4" }
        }
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "entity.name.type.framework.root.bml",
            "settings": { "foreground": "#FF79C6", "fontStyle": "bold" }
          },
          {
            "scope": "keyword.other.block-declaration.bml",
            "settings": { "foreground": "#C586C0" }
          },
          {
            "scope": "support.type.block-facet.bml",
            "settings": { "foreground": "#6A9955" }
          },
          {
            "scope": "keyword.other.block-container.bml",
            "settings": { "foreground": "#3794FF" }
          },
          {
            "scope": "keyword.other.member-container.bml",
            "settings": { "foreground": "#4EC9B0", "fontStyle": "bold" }
          },
          {
            "scope": "entity.name.member.bml",
            "settings": { "foreground": "#CE9178" }
          },
          {
            "scope": "keyword.other.member-field.bml",
            "settings": { "foreground": "#BB86FC" }
          },
          {
            "scope": "support.type.member-facet.bml",
            "settings": { "foreground": "#98C379" }
          },
          {
            "scope": "keyword.other.member-subcontainer.bml",
            "settings": { "foreground": "#56B6C2" }
          },
          {
            "scope": "entity.name.type.bml",
            "settings": { "foreground": "#DCDCAA" }
          },
          {
            "scope": "entity.name.type.instance.bml",
            "settings": { "foreground": "#E5C07B" }
          },
          {
            "scope": "entity.name.tag.bml",
            "settings": { "foreground": "#ABB2BF" }
          },
          {
            "scope": "entity.other.attribute-name.bml",
            "settings": { "foreground": "#9CDCFE" }
          },
          {
            "scope": "string.quoted.double.bml",
            "settings": { "foreground": "#CE9178" }
          },
          {
            "scope": "string.quoted.single.bml",
            "settings": { "foreground": "#D7BA7D" }
          },
          {
            "scope": "comment.block.bml",
            "settings": { "foreground": "#608B4E" }
          },
          {
            "scope": "keyword.other.interpolation.bml",
            "settings": { "foreground": "#D7BA7D" }
          },
          {
            "scope": "keyword.control.embed.bml",
            "settings": { "foreground": "#D16969" }
          },
          {
            "scope": "punctuation.definition.tag.bml",
            "settings": { "foreground": "#808080" }
          },
          {
            "scope": "punctuation.definition.comment.bml",
            "settings": { "foreground": "#608B4E" }
          },
          {
            "scope": "punctuation.separator.key-value.bml",
            "settings": { "foreground": "#D4D4D4" }
          }
        ]
      }
    },
    "configuration": {
      "title": "BlockML",
      "properties": {
        "blockml.bml.trace.server": {
          "type": "string",
          "default": "off",
          "description": "Traces the communication between VS Code and the BlockML language server.",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "scope": "window"
        },
        "blockml.bml.enableLanguageServer": {
          "type": "boolean",
          "default": true,
          "description": "Enable the BlockML language server client for diagnostics.",
          "scope": "window"
        },
        "blockml.bml.enableSemanticHighlighting": {
          "type": "boolean",
          "default": true,
          "description": "Enable semantic highlighting on top of the TextMate grammar (V2). Uses the BlockML classifier locally so nested files keep position-based colors.",
          "scope": "window"
        }
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npx --yes @vscode/vsce package",
    "validate": "blockml validate --all"
  },
  "dependencies": {
    "@blockml/lsp": "^0.9.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@blockml/core": "^1.0.9",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0",
    "@blockml/cli": "^0.9.0"
  }
}

<!--BlockML VS Code — abstract contribution

  FQN: org.blockml.bml.vscode.contribution.Contribution-->
<contrib:Contribution xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.vscode.documentation"
  xmlns:contrib="org.blockml.bml.vscode.contribution"
  xmlns:vtype="org.blockml.bml.vscode.type">

  <baseType>
    core:Entity
  </baseType>
  <is>
    A VS Code extension contribution
  </is>
  <documentation>
    Abstract branch for everything an Extension contributes — languages, grammars, icons,
    settings, commands, keybindings, language-server wiring, navigation, and semantic tokens.
    Concrete subtypes map to package.json contributes keys and/or generated feature modules.
    
    Every contribution declares a release milestone (V1 or V2) so generators can emit a partial
    extension matching the target roadmap slice.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="doc:ContributionModel" relation="AuthoringGuide">
      Contribution taxonomy and generator mapping.
    </see>
    <see type="vtype:ReleaseMilestone" relation="Requires">
      V1 / V2 milestone marker on every contribution.
    </see>
  </references>
  <properties>
    <milestone type="vtype:ReleaseMilestone">
      <documentation>
        Roadmap slice this contribution belongs to. Generators may filter by
        milestone when emitting a V1-only or full V2 extension.
      </documentation>
    </milestone>
    <enabled type="org.blockml.bml.type.Boolean">
      <documentation>
        Whether this contribution is active in the generated extension. Use false to
        keep a planned contribution in BML without shipping it yet.
      </documentation>
      <value>true</value>
    </enabled>
  </properties>
</contrib:Contribution>

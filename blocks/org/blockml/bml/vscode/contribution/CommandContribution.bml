<!--BlockML VS Code — command contribution

  FQN: org.blockml.bml.vscode.contribution.CommandContribution-->
<contrib:CommandContribution xmlns="http://blockml.org/bml"
  xmlns:contrib="org.blockml.bml.vscode.contribution">

  <baseType>
    contrib:Contribution
  </baseType>
  <is>
    A VS Code command contribution
  </is>
  <documentation>
    Maps to contributes.commands. Navigation shortcuts and editor actions register commands here;
    KeybindingContribution references the same command id.
  </documentation>
  <references>
    <see type="contrib:KeybindingContribution" relation="SeeAlso">
      Optional keybinding bound to this command id.
    </see>
    <see type="contrib:NavigationContribution" relation="SeeAlso">
      Navigation features often expose commands and editor gestures.
    </see>
  </references>
  <properties>
    <commandId type="org.blockml.bml.type.Text">
      <documentation>
        Fully qualified command id (for example blockml.bml.goToDefinition).
      </documentation>
    </commandId>
    <title type="org.blockml.bml.type.Text">
      <documentation>
        Command palette title.
      </documentation>
    </title>
    <category type="org.blockml.bml.type.Text">
      <documentation>
        Optional command category (for example BlockML).
      </documentation>
      <value>BlockML</value>
    </category>
    <icon type="org.blockml.bml.type.Text">
      <documentation>
        Optional codicon name or path for the command icon.
      </documentation>
    </icon>
  </properties>
</contrib:CommandContribution>

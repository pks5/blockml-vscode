<!--BlockML VS Code — TextMate grammar pattern

  FQN: org.blockml.bml.vscode.contribution.GrammarPattern-->
<contrib:GrammarPattern xmlns="http://blockml.org/bml"
  xmlns:contrib="org.blockml.bml.vscode.contribution"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Entity
  </baseType>
  <is>
    A TextMate repository pattern
  </is>
  <documentation>
    Structured TextMate pattern that generators emit into tmLanguage repository entries and top-level
    patterns includes. Prefer match XOR begin/end. Include-only patterns reference other repository
    keys via includeRef (for example #comment).
  </documentation>
  <references>
    <see type="contrib:GrammarContribution" relation="Requires">
      Patterns are aggregated under GrammarContribution.patterns.
    </see>
  </references>
  <properties>
    <patternKey type="type:Text">
      <documentation>
        Repository key (for example comment, tag, expression). Used as
        repository.&lt;patternKey> and as #patternKey includes.
      </documentation>
    </patternKey>
    <scopeName type="type:Text">
      <documentation>
        TextMate name / scope for this pattern (for example comment.block.bml).
        Optional for include-only or container patterns.
      </documentation>
    </scopeName>
    <match type="type:Text">
      <documentation>
        Oniguruma match regex. Mutually exclusive with begin/end for simple
        patterns.
      </documentation>
    </match>
    <begin type="type:Text">
      <documentation>
        Begin regex for multi-line / region patterns.
      </documentation>
    </begin>
    <end type="type:Text">
      <documentation>
        End regex pairing with begin.
      </documentation>
    </end>
    <contentName type="type:Text">
      <documentation>
        Optional TextMate contentName scope applied between begin and end.
      </documentation>
    </contentName>
    <includeRef type="type:Text">
      <documentation>
        When set, emit { "include": "#key" } or { "include": "source.other" }.
        Other regex fields should be empty.
      </documentation>
    </includeRef>
    <capturesJson type="type:Text">
      <documentation>
        Optional captures object as JSON text for match-based patterns
        (for example {"1":{"name":"entity.name.tag.bml"}}).
      </documentation>
    </capturesJson>
    <beginCapturesJson type="type:Text">
      <documentation>
        Optional beginCaptures object as JSON text.
      </documentation>
    </beginCapturesJson>
    <endCapturesJson type="type:Text">
      <documentation>
        Optional endCaptures object as JSON text.
      </documentation>
    </endCapturesJson>
  </properties>
  <aggregations>
    <nestedIncludes type="type:TextEntity[]">
      <documentation>
        Repository include refs applied inside begin/end patterns
        (for example #attribute, #expression). Emitted as patterns: [ { include: … } ].
      </documentation>
    </nestedIncludes>
  </aggregations>
</contrib:GrammarPattern>

<!--
  BlockML VS Code — editor color theme contribution

  FQN: org.blockml.bml.vscode.contribution.ColorThemeContribution
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:contrib="org.blockml.bml.vscode.contribution"
  xmlns:doc="org.blockml.bml.vscode.documentation"
  xmlns:theme="org.blockml.bml.vscode.theme"
  xmlns:type="org.blockml.bml.type">

  <name>ColorThemeContribution</name>
  <type>contrib:ColorThemeContribution</type>
  <baseType>contrib:Contribution</baseType>
  <is>An editor color theme contribution</is>

  <documentation>
    Registers a generated VS Code color theme. Maps to package.json contributes.themes plus a
    generated theme JSON file from the referenced theme:ColorTheme block (tokenColors, editor
    colors, label, uiTheme, themePath). When marketplace is true, also add the Themes category
    and emit contributes.themes[].id from ColorTheme.themeId so the theme is a first-class
    Marketplace / Open VSX listing — not only a local .vscode/settings.json default.

    Primary use: BlockML theme with one distinct color per *.bml TextMate scope. Position-based
    BML scopes are not colored by generic Dark+/Light+ families, so end-user syntax highlighting
    requires this custom theme. Grammar authors use the same theme to verify scopes.

    Do not invent tokenColors only in JSON — amend theme:ColorTheme / TokenColorRule in BML first,
    then re-render.
  </documentation>

  <references>
    <see type="doc:GenerationWorkflow" relation="AuthoringGuide">
      ColorTheme → themes/*.json render rules.
    </see>
    <see type="theme:ColorTheme" relation="Requires">
      Theme descriptor with tokenColors SSOT.
    </see>
    <see type="theme:HighlightScheme" relation="SeeAlso">
      Scopes the theme should cover.
    </see>
  </references>

  <properties>
    <colorTheme type="TypeReference(theme:ColorTheme)">
      <documentation>Concrete ColorTheme block (for example theme:BlockMlDevColorTheme).</documentation>
    </colorTheme>
    <marketplace type="Boolean">
      <documentation>When true, ship this theme as a Marketplace feature: include it in the
        published package contributes.themes, emit themes[].id, and add the Themes category.
        When false, keep it as a local grammar-development theme (workspace settings only).</documentation>
      <value>false</value>
    </marketplace>
  </properties>

</block>

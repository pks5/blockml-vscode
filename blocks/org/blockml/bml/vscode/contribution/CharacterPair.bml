<!--BlockML VS Code — character pair for language configuration

  FQN: org.blockml.bml.vscode.contribution.CharacterPair-->
<contrib:CharacterPair xmlns="http://blockml.org/bml"
  xmlns:contrib="org.blockml.bml.vscode.contribution"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Block
  </baseType>
  <is>
    A paired open/close character sequence
  </is>
  <documentation>
    Open/close pair used in language-configuration.json for brackets, autoClosingPairs, and
    surroundingPairs. Generators emit { "open": …, "close": … } objects from these properties.
  </documentation>
  <references>
    <see type="contrib:LanguageContribution" relation="Requires">
      Aggregated under LanguageContribution brackets / autoClosingPairs / surroundingPairs.
    </see>
  </references>
  <properties>
    <open type="org.blockml.bml.type.Text">
      <documentation>
        Opening character or string (for example &lt;, ", &lt;!--).
      </documentation>
    </open>
    <close type="org.blockml.bml.type.Text">
      <documentation>
        Closing character or string (for example >, ", -->).
      </documentation>
    </close>
  </properties>
</contrib:CharacterPair>

<!--BlockML VS Code — semantic highlighting contribution

  FQN: org.blockml.bml.vscode.contribution.SemanticHighlightingContribution-->
<contrib:SemanticHighlightingContribution xmlns="http://blockml.org/bml"
  xmlns:contrib="org.blockml.bml.vscode.contribution"
  xmlns:doc="org.blockml.bml.vscode.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    contrib:Contribution
  </baseType>
  <is>
    An advanced / semantic highlighting feature
  </is>
  <documentation>
    V2 advanced highlighting beyond TextMate — semantic tokens that classify tags by XML
    position (org.blockml.bml.vscode.theme.FrameworkRoles) so nested &lt;block> and
    composition keep the same colors as the TextMate grammar, without a rule-stack depth
    limit. Token types are the FrameworkRoles roleIds plus lexical types. The unnecessary
    modifier marks unused root xmlns:&lt;prefix&gt; declarations (prefix never used as a QName
    in the document) so the theme can fade / desaturate them.
    contributes.semanticTokenScopes maps them onto the existing *.bml TextMate scopes (Inspect
    / theme fallback). Colors must also be emitted as editor.semanticTokenColorCustomizations
    (ColorThemeContribution.overlaySemanticTokenColors) — tokenColorCustomizations alone does
    not style semantic tokens, so the TextMate overlay including stack failures would show
    through. The client evaluates the @blockml/lsp classifier locally so highlighting does not
    wait on LSP document sync; viaLanguageServer still advertises the legend on the server
    (types + modifiers). Works together with GrammarContribution (lexical fallback) rather
    than replacing it.
  </documentation>
  <references>
    <see type="doc:V2Scope" relation="AuthoringGuide">
      Advanced syntax highlighting is a V2 milestone.
    </see>
    <see type="contrib:GrammarContribution" relation="SeeAlso">
      Lexical TextMate baseline highlighting.
    </see>
    <see type="contrib:LanguageServerContribution" relation="SeeAlso">
      Semantic tokens usually require the language server.
    </see>
  </references>
  <properties>
    <viaLanguageServer type="type:Boolean">
      <documentation>
        When true, semantic tokens come from the LSP; otherwise a client
        DocumentSemanticTokensProvider may be generated.
      </documentation>
      <value>true</value>
    </viaLanguageServer>
  </properties>
  <aggregations>
    <tokenTypes type="type:TextEntity[]">
      <documentation>
        Semantic token types to register / request (namespace, type, property,
        variable, keyword, modifier, …).
      </documentation>
    </tokenTypes>
    <tokenModifiers type="type:TextEntity[]">
      <documentation>
        Semantic token modifiers (declaration, definition, readonly, deprecated,
        abstract, …).
      </documentation>
    </tokenModifiers>
  </aggregations>
</contrib:SemanticHighlightingContribution>

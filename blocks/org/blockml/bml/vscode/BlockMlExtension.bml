<!--
  BlockML VS Code — concrete BlockML extension catalogue

  FQN: org.blockml.bml.vscode.BlockMlExtension

  SSOT for the BlockML VS Code / Cursor plugin — V1 and V2 contributions and settings.
  Generators / LLMs materialize the runnable extension from this Block.
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:contrib="org.blockml.bml.vscode.contribution"
  xmlns:doc="org.blockml.bml.vscode.documentation"
  xmlns:theme="org.blockml.bml.vscode.theme"
  xmlns:type="org.blockml.bml.type"
  xmlns:vscode="org.blockml.bml.vscode"
  xmlns:vtype="org.blockml.bml.vscode.type">

  <name>BlockMlExtension</name>
  <type>vscode:BlockMlExtension</type>
  <baseType>vscode:Extension</baseType>
  <is>The BlockML VS Code extension</is>

  <summary>Concrete extension catalogue for BlockML (.bml) authoring — V1 file type, icon, and
    simple highlighting; V2 language server, advanced highlighting, and Java-like navigation.</summary>

  <documentation>
    Filled Extension descriptor for publisher blockml / name bml. Contribution children declare
    milestone V1 or V2. Settings under configuration are the SSOT for package.json
    contributes.configuration.

    Read documentation blocks (V1Scope, V2Scope, GenerationWorkflow) before generating sources.
  </documentation>

  <references>
    <see type="doc:V1Scope" relation="AuthoringGuide">
      V1 feature scope.
    </see>
    <see type="doc:V2Scope" relation="AuthoringGuide">
      V2 feature scope.
    </see>
    <see type="doc:GenerationWorkflow" relation="AuthoringGuide">
      BML → extension generation rules.
    </see>
    <see type="theme:FrameworkRoles" relation="SeeAlso">
      Active V1 semantic highlight scheme for framework tag colors.
    </see>
    <see type="theme:BlockMlDevColorTheme" relation="SeeAlso">
      Dev color theme — one color per BML TextMate scope for grammar authoring.
    </see>
    <see type="vscode:Extension" relation="Extends">
      Abstract extension descriptor.
    </see>
  </references>

  <properties>
    <publisher>
      <value>blockml</value>
    </publisher>
    <name>
      <value>bml</value>
    </name>
    <displayName>
      <value>BlockML</value>
    </displayName>
    <description>
      <value>Language support for BlockML (BML) — syntax highlighting, file icons, and IDE features.</value>
    </description>
    <icon>
      <value>./icons/blockml.png</value>
    </icon>
    <version>
      <value>0.1.0</value>
    </version>
    <enginesVscode>
      <value>^1.85.0</value>
    </enginesVscode>
    <main>
      <value>./out/extension.js</value>
    </main>
    <license>
      <value>Apache-2.0</value>
    </license>
  </properties>

  <aggregations>
    <categories>
      <type:TextEntity value="Programming Languages" />
    </categories>

    <activationEvents>
      <type:TextEntity value="onLanguage:bml" />
    </activationEvents>

    <contributions>

      <!-- ========== V1 ========== -->

      <contrib:LanguageContribution bml:id="bmlLanguage">
        <milestone>
          <value>V1</value>
        </milestone>
        <enabled>
          <value>true</value>
        </enabled>
        <languageId>
          <value>bml</value>
        </languageId>
        <configurationPath>
          <value>./language-configuration.json</value>
        </configurationPath>
        <blockCommentOpen>
          <value>&lt;!--</value>
        </blockCommentOpen>
        <blockCommentClose>
          <value>--&gt;</value>
        </blockCommentClose>
        <aliases>
          <type:TextEntity value="BlockML" />
          <type:TextEntity value="BML" />
        </aliases>
        <extensions>
          <type:TextEntity value=".bml" />
        </extensions>
        <brackets>
          <contrib:CharacterPair bml:id="bracketAngle">
            <open><value>&lt;</value></open>
            <close><value>&gt;</value></close>
          </contrib:CharacterPair>
          <contrib:CharacterPair bml:id="bracketCurly">
            <open><value>{</value></open>
            <close><value>}</value></close>
          </contrib:CharacterPair>
          <contrib:CharacterPair bml:id="bracketParen">
            <open><value>(</value></open>
            <close><value>)</value></close>
          </contrib:CharacterPair>
          <contrib:CharacterPair bml:id="bracketSquare">
            <open><value>[</value></open>
            <close><value>]</value></close>
          </contrib:CharacterPair>
        </brackets>
        <autoClosingPairs>
          <contrib:CharacterPair bml:id="autoAngle">
            <open><value>&lt;</value></open>
            <close><value>&gt;</value></close>
          </contrib:CharacterPair>
          <contrib:CharacterPair bml:id="autoDoubleQuote">
            <open><value>"</value></open>
            <close><value>"</value></close>
          </contrib:CharacterPair>
          <contrib:CharacterPair bml:id="autoSingleQuote">
            <open><value>'</value></open>
            <close><value>'</value></close>
          </contrib:CharacterPair>
          <contrib:CharacterPair bml:id="autoCurly">
            <open><value>{</value></open>
            <close><value>}</value></close>
          </contrib:CharacterPair>
          <contrib:CharacterPair bml:id="autoParen">
            <open><value>(</value></open>
            <close><value>)</value></close>
          </contrib:CharacterPair>
          <contrib:CharacterPair bml:id="autoSquare">
            <open><value>[</value></open>
            <close><value>]</value></close>
          </contrib:CharacterPair>
          <contrib:CharacterPair bml:id="autoBlockComment">
            <open><value>&lt;!--</value></open>
            <close><value>--&gt;</value></close>
          </contrib:CharacterPair>
        </autoClosingPairs>
        <surroundingPairs>
          <contrib:CharacterPair bml:id="surroundAngle">
            <open><value>&lt;</value></open>
            <close><value>&gt;</value></close>
          </contrib:CharacterPair>
          <contrib:CharacterPair bml:id="surroundDoubleQuote">
            <open><value>"</value></open>
            <close><value>"</value></close>
          </contrib:CharacterPair>
          <contrib:CharacterPair bml:id="surroundSingleQuote">
            <open><value>'</value></open>
            <close><value>'</value></close>
          </contrib:CharacterPair>
          <contrib:CharacterPair bml:id="surroundCurly">
            <open><value>{</value></open>
            <close><value>}</value></close>
          </contrib:CharacterPair>
          <contrib:CharacterPair bml:id="surroundParen">
            <open><value>(</value></open>
            <close><value>)</value></close>
          </contrib:CharacterPair>
          <contrib:CharacterPair bml:id="surroundSquare">
            <open><value>[</value></open>
            <close><value>]</value></close>
          </contrib:CharacterPair>
        </surroundingPairs>
      </contrib:LanguageContribution>

      <contrib:GrammarContribution bml:id="bmlSimpleGrammar">
        <milestone>
          <value>V1</value>
        </milestone>
        <enabled>
          <value>true</value>
        </enabled>
        <languageId>
          <value>bml</value>
        </languageId>
        <scopeName>
          <value>source.bml</value>
        </scopeName>
        <path>
          <value>./syntaxes/bml.tmLanguage.json</value>
        </path>
        <embeddedLanguagesNote>
          <value>CDATA and capability implementation bodies may embed PseudoCode or other dialects later; V1 treats them as plain text/string scopes.</value>
        </embeddedLanguagesNote>
        <highlightScheme>
          <value>theme:FrameworkRoles</value>
        </highlightScheme>
        <scopes>
          <type:TextEntity value="comment.block.bml" />
          <type:TextEntity value="meta.tag.bml" />
          <type:TextEntity value="entity.name.type.framework.root.bml" />
          <type:TextEntity value="keyword.other.definition.bml" />
          <type:TextEntity value="keyword.other.container.bml" />
          <type:TextEntity value="support.type.framework.facet.bml" />
          <type:TextEntity value="entity.name.type.bml" />
          <type:TextEntity value="entity.name.tag.bml" />
          <type:TextEntity value="entity.other.attribute-name.bml" />
          <type:TextEntity value="string.quoted.double.bml" />
          <type:TextEntity value="string.quoted.single.bml" />
          <type:TextEntity value="keyword.other.interpolation.bml" />
          <type:TextEntity value="keyword.control.embed.bml" />
          <type:TextEntity value="punctuation.definition.interpolation.bml" />
          <type:TextEntity value="punctuation.definition.embed.bml" />
          <type:TextEntity value="punctuation.definition.comment.bml" />
          <type:TextEntity value="punctuation.definition.tag.bml" />
        </scopes>
        <patternNotes>
          <type:TextEntity value="XML-style comments &lt;!-- --&gt;" />
          <type:TextEntity value="Context-aware nesting: inside &lt;block&gt;, framework roles apply at block level" />
          <type:TextEntity value="Member containers (properties/aggregations/associations/capabilities/constraints): direct children are domain member names (entity.name.tag.bml)" />
          <type:TextEntity value="Inside a member element: identity/facet field tags regain framework scopes (e.g. &lt;documentation&gt; facet under &lt;myProp&gt;, but &lt;documentation&gt; property name stays domain)" />
          <type:TextEntity value="Framework root tag block (theme:FrameworkRoles role root)" />
          <type:TextEntity value="Framework identity tags name/type/baseType/… (role identity)" />
          <type:TextEntity value="Framework container tags — keyword.other.container.bml (role container)" />
          <type:TextEntity value="Framework facet tags value/documentation/… (role facet) — block level and member interior only" />
          <type:TextEntity value="Domain / user member tags — fallback entity.name.tag.bml (camelCase / lowercase local name)" />
          <type:TextEntity value="PascalCase domain type tags — entity.name.type.bml (&lt;MyBlock&gt;, &lt;ns:MyBlock&gt;, role domainType; regex (?:prefix:)?[A-Z]…)" />
          <type:TextEntity value="Attribute names and quoted attribute values" />
          <type:TextEntity value="${ ... } expression interpolations" />
          <type:TextEntity value="&lt;$ ... $&gt; embedded expression markers" />
        </patternNotes>
        <topLevelIncludes>
          <type:TextEntity value="comment" />
          <type:TextEntity value="expression" />
          <type:TextEntity value="embed" />
          <type:TextEntity value="block" />
          <type:TextEntity value="tagRoot" />
          <type:TextEntity value="tagIdentity" />
          <type:TextEntity value="tagBlockContainer" />
          <type:TextEntity value="tagMemberContainer" />
          <type:TextEntity value="tagFacet" />
          <type:TextEntity value="tagDomainType" />
          <type:TextEntity value="tag" />
        </topLevelIncludes>
        <patterns>
          <contrib:GrammarPattern bml:id="patternComment">
            <patternKey><value>comment</value></patternKey>
            <scopeName><value>comment.block.bml</value></scopeName>
            <begin><value>&lt;!--</value></begin>
            <end><value>--&gt;</value></end>
            <beginCapturesJson><value>{"0":{"name":"punctuation.definition.comment.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"0":{"name":"punctuation.definition.comment.bml"}}</value></endCapturesJson>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternExpression">
            <patternKey><value>expression</value></patternKey>
            <scopeName><value>keyword.other.interpolation.bml</value></scopeName>
            <begin><value>\$\{</value></begin>
            <end><value>\}</value></end>
            <beginCapturesJson><value>{"0":{"name":"punctuation.definition.interpolation.begin.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"0":{"name":"punctuation.definition.interpolation.end.bml"}}</value></endCapturesJson>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternEmbed">
            <patternKey><value>embed</value></patternKey>
            <scopeName><value>keyword.control.embed.bml</value></scopeName>
            <begin><value>&lt;\$</value></begin>
            <end><value>\$&gt;</value></end>
            <beginCapturesJson><value>{"0":{"name":"punctuation.definition.embed.begin.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"0":{"name":"punctuation.definition.embed.end.bml"}}</value></endCapturesJson>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternDoubleQuoted">
            <patternKey><value>stringDouble</value></patternKey>
            <scopeName><value>string.quoted.double.bml</value></scopeName>
            <begin><value>"</value></begin>
            <end><value>"</value></end>
            <nestedIncludes>
              <type:TextEntity value="#expression" />
              <type:TextEntity value="#embed" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternSingleQuoted">
            <patternKey><value>stringSingle</value></patternKey>
            <scopeName><value>string.quoted.single.bml</value></scopeName>
            <begin><value>'</value></begin>
            <end><value>'</value></end>
            <nestedIncludes>
              <type:TextEntity value="#expression" />
              <type:TextEntity value="#embed" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternAttribute">
            <patternKey><value>attribute</value></patternKey>
            <match><value>\s+([A-Za-z_:][\w:.-]*)(\s*=\s*)(?:(")([^"]*)(")|(')([^']*)('))?</value></match>
            <capturesJson><value>{"1":{"name":"entity.other.attribute-name.bml"},"2":{"name":"punctuation.separator.key-value.bml"},"3":{"name":"punctuation.definition.string.begin.bml"},"4":{"name":"string.quoted.double.bml"},"5":{"name":"punctuation.definition.string.end.bml"},"6":{"name":"punctuation.definition.string.begin.bml"},"7":{"name":"string.quoted.single.bml"},"8":{"name":"punctuation.definition.string.end.bml"}}</value></capturesJson>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternBlock">
            <patternKey><value>block</value></patternKey>
            <scopeName><value>meta.tag.bml</value></scopeName>
            <begin><value>(&lt;)(block)(?=[\s/>])</value></begin>
            <end><value>(/?&gt;)</value></end>
            <beginCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.type.framework.root.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"}}</value></endCapturesJson>
            <nestedIncludes>
              <type:TextEntity value="#attribute" />
              <type:TextEntity value="#blockBody" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternBlockBody">
            <patternKey><value>blockBody</value></patternKey>
            <includeRef><value>#tagIdentityElement</value></includeRef>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternMemberTypeElement">
            <patternKey><value>memberTypeElement</value></patternKey>
            <scopeName><value>meta.tag.bml</value></scopeName>
            <begin><value>(&lt;)((?:[A-Za-z_][\w.-]*:)?[A-Z][a-zA-Z0-9]*)(?=[\s/>])</value></begin>
            <end><value>(/?&gt;)</value></end>
            <beginCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.type.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"}}</value></endCapturesJson>
            <nestedIncludes>
              <type:TextEntity value="#attribute" />
              <type:TextEntity value="#memberBody" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternDomainTypeElement">
            <patternKey><value>domainTypeElement</value></patternKey>
            <scopeName><value>meta.tag.bml</value></scopeName>
            <begin><value>(&lt;)((?:[A-Za-z_][\w.-]*:)?[A-Z][a-zA-Z0-9]*)(?=[\s/>])</value></begin>
            <end><value>(/?&gt;)</value></end>
            <beginCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.type.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"}}</value></endCapturesJson>
            <nestedIncludes>
              <type:TextEntity value="#attribute" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternCloseTagDomainType">
            <patternKey><value>closeTagDomainType</value></patternKey>
            <match><value>(&lt;/)((?:[A-Za-z_][\w.-]*:)?[A-Z][a-zA-Z0-9]*)(\s*(>))</value></match>
            <capturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.type.bml"},"3":{"name":"punctuation.definition.tag.bml"}}</value></capturesJson>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternMemberElement">
            <patternKey><value>memberElement</value></patternKey>
            <scopeName><value>meta.tag.bml</value></scopeName>
            <begin><value>(&lt;)((?:[A-Za-z_][\w.-]*:)?[a-z_][\w.-]*)(?=[\s/>])</value></begin>
            <end><value>(/?&gt;)</value></end>
            <beginCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.tag.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"}}</value></endCapturesJson>
            <nestedIncludes>
              <type:TextEntity value="#attribute" />
              <type:TextEntity value="#memberBody" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternTagMemberContainerElement">
            <patternKey><value>tagMemberContainerElement</value></patternKey>
            <scopeName><value>meta.tag.bml</value></scopeName>
            <begin><value>(&lt;)(properties|aggregations|associations|capabilities|constraints)(?=[\s/>])</value></begin>
            <end><value>(/?&gt;)</value></end>
            <beginCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"keyword.other.container.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"}}</value></endCapturesJson>
            <nestedIncludes>
              <type:TextEntity value="#attribute" />
              <type:TextEntity value="#memberContainerBody" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternTagBlockContainerElement">
            <patternKey><value>tagBlockContainerElement</value></patternKey>
            <scopeName><value>meta.tag.bml</value></scopeName>
            <begin><value>(&lt;)(contracts|subBlocks|embeddedBlocks|composition|genericTypes|groups|aliases|keywords|references|blocks|readMe|library)(?=[\s/>])</value></begin>
            <end><value>(/?&gt;)</value></end>
            <beginCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"keyword.other.container.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"}}</value></endCapturesJson>
            <nestedIncludes>
              <type:TextEntity value="#attribute" />
              <type:TextEntity value="#blockContainerBody" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternTagIdentityElement">
            <patternKey><value>tagIdentityElement</value></patternKey>
            <scopeName><value>meta.tag.bml</value></scopeName>
            <begin><value>(&lt;)(name|type|baseType|is|isnot|version|abstract|final|definition|language)(?=[\s/>])</value></begin>
            <end><value>(/?&gt;)</value></end>
            <beginCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"keyword.other.definition.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"}}</value></endCapturesJson>
            <nestedIncludes>
              <type:TextEntity value="#attribute" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternTagFacetElement">
            <patternKey><value>tagFacetElement</value></patternKey>
            <scopeName><value>meta.tag.bml</value></scopeName>
            <begin><value>(&lt;)(value|documentation|summary|implementation|inputType|outputType|override|readOnly|visibility|status|since|changelog|examples|relation|see|content|default|description|title|bml:xml|bml:container)(?=[\s/>])</value></begin>
            <end><value>(/?&gt;)</value></end>
            <beginCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"support.type.framework.facet.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"}}</value></endCapturesJson>
            <nestedIncludes>
              <type:TextEntity value="#attribute" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternTagRoot">
            <patternKey><value>tagRoot</value></patternKey>
            <scopeName><value>meta.tag.bml</value></scopeName>
            <begin><value>(&lt;/?)(block)(?=[\s/>])</value></begin>
            <end><value>(/?&gt;)</value></end>
            <beginCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.type.framework.root.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"}}</value></endCapturesJson>
            <nestedIncludes>
              <type:TextEntity value="#attribute" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternTagIdentity">
            <patternKey><value>tagIdentity</value></patternKey>
            <scopeName><value>meta.tag.bml</value></scopeName>
            <begin><value>(&lt;/?)(name|type|baseType|is|isnot|version|abstract|final|definition|language)(?=[\s/>])</value></begin>
            <end><value>(/?&gt;)</value></end>
            <beginCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"keyword.other.definition.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"}}</value></endCapturesJson>
            <nestedIncludes>
              <type:TextEntity value="#attribute" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternTagBlockContainer">
            <patternKey><value>tagBlockContainer</value></patternKey>
            <scopeName><value>meta.tag.bml</value></scopeName>
            <begin><value>(&lt;/?)(contracts|subBlocks|embeddedBlocks|composition|genericTypes|groups|aliases|keywords|references|blocks|readMe|library)(?=[\s/>])</value></begin>
            <end><value>(/?&gt;)</value></end>
            <beginCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"keyword.other.container.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"}}</value></endCapturesJson>
            <nestedIncludes>
              <type:TextEntity value="#attribute" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternTagMemberContainer">
            <patternKey><value>tagMemberContainer</value></patternKey>
            <scopeName><value>meta.tag.bml</value></scopeName>
            <begin><value>(&lt;/?)(properties|aggregations|associations|capabilities|constraints)(?=[\s/>])</value></begin>
            <end><value>(/?&gt;)</value></end>
            <beginCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"keyword.other.container.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"}}</value></endCapturesJson>
            <nestedIncludes>
              <type:TextEntity value="#attribute" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternTagFacet">
            <patternKey><value>tagFacet</value></patternKey>
            <scopeName><value>meta.tag.bml</value></scopeName>
            <begin><value>(&lt;/?)(value|documentation|summary|implementation|inputType|outputType|override|readOnly|visibility|status|since|changelog|examples|relation|see|content|default|description|title|bml:xml|bml:container)(?=[\s/>])</value></begin>
            <end><value>(/?&gt;)</value></end>
            <beginCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"support.type.framework.facet.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"}}</value></endCapturesJson>
            <nestedIncludes>
              <type:TextEntity value="#attribute" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternTagDomainType">
            <patternKey><value>tagDomainType</value></patternKey>
            <scopeName><value>meta.tag.bml</value></scopeName>
            <begin><value>(&lt;/?)((?:[A-Za-z_][\w.-]*:)?[A-Z][a-zA-Z0-9]*)(?=[\s/>])</value></begin>
            <end><value>(/?&gt;)</value></end>
            <beginCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.type.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"}}</value></endCapturesJson>
            <nestedIncludes>
              <type:TextEntity value="#attribute" />
            </nestedIncludes>
          </contrib:GrammarPattern>

          <contrib:GrammarPattern bml:id="patternTag">
            <patternKey><value>tag</value></patternKey>
            <scopeName><value>meta.tag.bml</value></scopeName>
            <begin><value>(&lt;/?)((?:[A-Za-z_][\w.-]*:)?[a-z_][\w.-]*)</value></begin>
            <end><value>(/?&gt;)</value></end>
            <beginCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.tag.bml"}}</value></beginCapturesJson>
            <endCapturesJson><value>{"1":{"name":"punctuation.definition.tag.bml"}}</value></endCapturesJson>
            <nestedIncludes>
              <type:TextEntity value="#attribute" />
            </nestedIncludes>
          </contrib:GrammarPattern>
        </patterns>
      </contrib:GrammarContribution>

      <contrib:IconContribution bml:id="bmlFileIcon">
        <milestone>
          <value>V1</value>
        </milestone>
        <enabled>
          <value>true</value>
        </enabled>
        <languageId>
          <value>bml</value>
        </languageId>
        <iconPath>
          <value>./icons/blockml.svg</value>
        </iconPath>
        <fileExtension>
          <value>.bml</value>
        </fileExtension>
        <themeId>
          <value>blockml-icons</value>
        </themeId>
        <themeLabel>
          <value>BlockML Icons</value>
        </themeLabel>
        <themePath>
          <value>./icons/blockml-icon-theme.json</value>
        </themePath>
        <iconDefinitionId>
          <value>bml_file</value>
        </iconDefinitionId>
      </contrib:IconContribution>

      <contrib:ColorThemeContribution bml:id="bmlDevColorTheme">
        <milestone>
          <value>V1</value>
        </milestone>
        <enabled>
          <value>true</value>
        </enabled>
        <colorTheme>
          <value>theme:BlockMlDevColorTheme</value>
        </colorTheme>
      </contrib:ColorThemeContribution>

      <contrib:ConfigurationContribution bml:id="blockmlConfiguration">
        <milestone>
          <value>V1</value>
        </milestone>
        <enabled>
          <value>true</value>
        </enabled>
        <title>
          <value>BlockML</value>
        </title>
        <settings>

          <contrib:Setting bml:id="traceServer">
            <key>
              <value>blockml.bml.trace.server</value>
            </key>
            <valueKind>
              <value>String</value>
            </valueKind>
            <defaultValue>
              <value>off</value>
            </defaultValue>
            <description>
              <value>Traces the communication between VS Code and the BlockML language server (V2).</value>
            </description>
            <scope>
              <value>Window</value>
            </scope>
            <enumValues>
              <type:TextEntity value="off" />
              <type:TextEntity value="messages" />
              <type:TextEntity value="verbose" />
            </enumValues>
          </contrib:Setting>

          <contrib:Setting bml:id="enableLanguageServer">
            <key>
              <value>blockml.bml.enableLanguageServer</value>
            </key>
            <valueKind>
              <value>Boolean</value>
            </valueKind>
            <defaultValue>
              <value>true</value>
            </defaultValue>
            <description>
              <value>Enable the BlockML language server client (V2). Ignored until the V2 milestone is shipped.</value>
            </description>
            <scope>
              <value>Window</value>
            </scope>
          </contrib:Setting>

          <contrib:Setting bml:id="enableSemanticHighlighting">
            <key>
              <value>blockml.bml.enableSemanticHighlighting</value>
            </key>
            <valueKind>
              <value>Boolean</value>
            </valueKind>
            <defaultValue>
              <value>true</value>
            </defaultValue>
            <description>
              <value>Enable LSP semantic highlighting on top of the TextMate grammar (V2).</value>
            </description>
            <scope>
              <value>Window</value>
            </scope>
          </contrib:Setting>

        </settings>
      </contrib:ConfigurationContribution>

      <!-- ========== V2 ========== -->

      <contrib:LanguageServerContribution bml:id="bmlLanguageServer">
        <milestone>
          <value>V2</value>
        </milestone>
        <enabled>
          <value>true</value>
        </enabled>
        <serverModulePath>
          <value>./server/out/server.js</value>
        </serverModulePath>
        <transport>
          <value>ipc</value>
        </transport>
        <traceSettingKey>
          <value>blockml.bml.trace.server</value>
        </traceSettingKey>
        <documentSelectors>
          <type:TextEntity value="language:bml" />
          <type:TextEntity value="scheme:file" />
        </documentSelectors>
        <clientFeatures>
          <type:TextEntity value="diagnostics" />
          <type:TextEntity value="hover" />
          <type:TextEntity value="completion" />
          <type:TextEntity value="definition" />
          <type:TextEntity value="references" />
          <type:TextEntity value="documentSymbol" />
          <type:TextEntity value="semanticTokens" />
        </clientFeatures>
      </contrib:LanguageServerContribution>

      <contrib:GrammarContribution bml:id="bmlAdvancedGrammar">
        <milestone>
          <value>V2</value>
        </milestone>
        <enabled>
          <value>true</value>
        </enabled>
        <languageId>
          <value>bml</value>
        </languageId>
        <scopeName>
          <value>source.bml</value>
        </scopeName>
        <path>
          <value>./syntaxes/bml.tmLanguage.json</value>
        </path>
        <embeddedLanguagesNote>
          <value>V2 extends V1 patterns with type-reference-looking QNames, bml:* directives, and clearer member/property name scopes; semantic tokens refine further.</value>
        </embeddedLanguagesNote>
        <scopes>
          <type:TextEntity value="entity.name.type.bml" />
          <type:TextEntity value="entity.name.namespace.bml" />
          <type:TextEntity value="keyword.control.directive.bml" />
          <type:TextEntity value="variable.other.member.bml" />
          <type:TextEntity value="support.type.property-name.bml" />
        </scopes>
        <patternNotes>
          <type:TextEntity value="Prefixed type references (core:Block, type:Text, …)" />
          <type:TextEntity value="bml:id / bml:version / bml:each / bml:if / bml:xml directive attributes" />
          <type:TextEntity value="Member element names under properties/aggregations/associations/capabilities" />
        </patternNotes>
      </contrib:GrammarContribution>

      <contrib:SemanticHighlightingContribution bml:id="bmlSemanticHighlighting">
        <milestone>
          <value>V2</value>
        </milestone>
        <enabled>
          <value>true</value>
        </enabled>
        <viaLanguageServer>
          <value>true</value>
        </viaLanguageServer>
        <tokenTypes>
          <type:TextEntity value="namespace" />
          <type:TextEntity value="type" />
          <type:TextEntity value="class" />
          <type:TextEntity value="property" />
          <type:TextEntity value="variable" />
          <type:TextEntity value="keyword" />
          <type:TextEntity value="modifier" />
        </tokenTypes>
        <tokenModifiers>
          <type:TextEntity value="declaration" />
          <type:TextEntity value="definition" />
          <type:TextEntity value="readonly" />
          <type:TextEntity value="deprecated" />
          <type:TextEntity value="abstract" />
          <type:TextEntity value="defaultLibrary" />
        </tokenModifiers>
      </contrib:SemanticHighlightingContribution>

      <contrib:NavigationContribution bml:id="bmlNavigation">
        <milestone>
          <value>V2</value>
        </milestone>
        <enabled>
          <value>true</value>
        </enabled>
        <preferLanguageServer>
          <value>true</value>
        </preferLanguageServer>
        <ctrlClickEnabled>
          <value>true</value>
        </ctrlClickEnabled>
        <kinds>
          <type:TextEntity value="BlockType" />
          <type:TextEntity value="BaseType" />
          <type:TextEntity value="Property" />
          <type:TextEntity value="Aggregation" />
          <type:TextEntity value="Association" />
          <type:TextEntity value="Capability" />
          <type:TextEntity value="ReferenceSee" />
          <type:TextEntity value="InstanceId" />
          <type:TextEntity value="NamespacePrefix" />
        </kinds>
        <gestures>
          <type:TextEntity value="goToDefinition" />
          <type:TextEntity value="peekDefinition" />
          <type:TextEntity value="findReferences" />
          <type:TextEntity value="goToTypeDefinition" />
        </gestures>
      </contrib:NavigationContribution>

      <contrib:CommandContribution bml:id="goToDefinitionCommand">
        <milestone>
          <value>V2</value>
        </milestone>
        <enabled>
          <value>true</value>
        </enabled>
        <commandId>
          <value>blockml.bml.goToDefinition</value>
        </commandId>
        <title>
          <value>Go to Definition</value>
        </title>
        <category>
          <value>BlockML</value>
        </category>
      </contrib:CommandContribution>

      <contrib:CommandContribution bml:id="peekDefinitionCommand">
        <milestone>
          <value>V2</value>
        </milestone>
        <enabled>
          <value>true</value>
        </enabled>
        <commandId>
          <value>blockml.bml.peekDefinition</value>
        </commandId>
        <title>
          <value>Peek Definition</value>
        </title>
        <category>
          <value>BlockML</value>
        </category>
      </contrib:CommandContribution>

      <contrib:CommandContribution bml:id="findReferencesCommand">
        <milestone>
          <value>V2</value>
        </milestone>
        <enabled>
          <value>true</value>
        </enabled>
        <commandId>
          <value>blockml.bml.findReferences</value>
        </commandId>
        <title>
          <value>Find All References</value>
        </title>
        <category>
          <value>BlockML</value>
        </category>
      </contrib:CommandContribution>

      <contrib:KeybindingContribution bml:id="goToDefinitionKey">
        <milestone>
          <value>V2</value>
        </milestone>
        <enabled>
          <value>true</value>
        </enabled>
        <commandId>
          <value>blockml.bml.goToDefinition</value>
        </commandId>
        <key>
          <value>f12</value>
        </key>
        <when>
          <value>editorLangId == 'bml'</value>
        </when>
      </contrib:KeybindingContribution>

      <contrib:KeybindingContribution bml:id="peekDefinitionKey">
        <milestone>
          <value>V2</value>
        </milestone>
        <enabled>
          <value>true</value>
        </enabled>
        <commandId>
          <value>blockml.bml.peekDefinition</value>
        </commandId>
        <key>
          <value>alt+f12</value>
        </key>
        <when>
          <value>editorLangId == 'bml'</value>
        </when>
      </contrib:KeybindingContribution>

      <contrib:KeybindingContribution bml:id="findReferencesKey">
        <milestone>
          <value>V2</value>
        </milestone>
        <enabled>
          <value>true</value>
        </enabled>
        <commandId>
          <value>blockml.bml.findReferences</value>
        </commandId>
        <key>
          <value>shift+f12</value>
        </key>
        <when>
          <value>editorLangId == 'bml'</value>
        </when>
      </contrib:KeybindingContribution>

    </contributions>
  </aggregations>

</block>

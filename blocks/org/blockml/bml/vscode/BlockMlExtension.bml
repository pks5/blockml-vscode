<!--
  BlockML VS Code — concrete BlockML extension catalogue

  FQN: org.blockml.bml.vscode.BlockMlExtension

  SSOT for the BlockML VS Code / Cursor plugin — V1 and V2 contributions and settings.
  Generators / LLMs materialize the runnable extension from this Block.
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:contrib="org.blockml.bml.vscode.contribution"
  xmlns:doc="org.blockml.bml.vscode.documentation"
  xmlns:theme="org.blockml.bml.vscode.theme"
  xmlns:type="org.blockml.bml.type"
  xmlns:vscode="org.blockml.bml.vscode"
  xmlns:vtype="org.blockml.bml.vscode.type">

  <name>BlockMlExtension</name>
  <type>vscode:BlockMlExtension</type>
  <baseType>vscode:Extension</baseType>
  <is>The BlockML VS Code extension</is>

  <summary>Concrete extension catalogue for BlockML (.bml) authoring — V1 file type, icon, and
    simple highlighting; V2 language server, advanced highlighting, and Java-like navigation.</summary>

  <documentation>
    Filled Extension descriptor for publisher blockml / name bml. Contribution children declare
    milestone V1 or V2. Settings under configuration are the SSOT for package.json
    contributes.configuration.

    Read documentation blocks (V1Scope, V2Scope, GenerationWorkflow) before generating sources.
  </documentation>

  <references>
    <see type="doc:V1Scope" relation="AuthoringGuide">
      V1 feature scope.
    </see>
    <see type="doc:V2Scope" relation="AuthoringGuide">
      V2 feature scope.
    </see>
    <see type="doc:GenerationWorkflow" relation="AuthoringGuide">
      BML → extension generation rules.
    </see>
    <see type="theme:FrameworkRoles" relation="SeeAlso">
      Active V1 semantic highlight scheme for framework tag colors.
    </see>
    <see type="theme:BlockMlDevColorTheme" relation="SeeAlso">
      Shipped Marketplace color theme — one color per BML TextMate scope; required for syntax
      highlighting.
    </see>
    <see type="vscode:Extension" relation="Extends">
      Abstract extension descriptor.
    </see>
  </references>

  <properties>
    <publisher override="true">
      <value>blockml</value>
    </publisher>
    <name override="true">
      <value>bml</value>
    </name>
    <displayName override="true">
      <value>BlockML</value>
    </displayName>
    <description override="true">
      <value>Language support for BlockML (BML) — syntax highlighting, diagnostics via language server, and file icons.</value>
    </description>
    <icon override="true">
      <value>./icons/blockml.png</value>
    </icon>
    <version override="true">
      <value>0.2.0</value>
    </version>
    <enginesVscode override="true">
      <value>^1.85.0</value>
    </enginesVscode>
    <main override="true">
      <value>./out/extension.js</value>
    </main>
    <license override="true">
      <value>Apache-2.0</value>
    </license>
  </properties>

  <aggregations>
    <categories>
      <composition>
        <type:TextEntity value="Programming Languages" />
      </composition>
    </categories>

    <activationEvents>
      <composition>
        <type:TextEntity value="onLanguage:bml" />
        <type:TextEntity value="workspaceContains:**/*.bml" />
      </composition>
    </activationEvents>

    <contributions>
      <composition>
        <!-- ========== V1 ========== -->

        <contrib:LanguageContribution bml:id="bmlLanguage">
          <milestone>V1</milestone>
          <enabled>true</enabled>
          <languageId>bml</languageId>
          <xmlLanguageParticipant>true</xmlLanguageParticipant>
          <configurationPath>./language-configuration.json</configurationPath>
          <blockCommentOpen>&lt;!--</blockCommentOpen>
          <blockCommentClose>--&gt;</blockCommentClose>
          <aliases>
            <type:TextEntity value="BlockML" />
            <type:TextEntity value="BML" />
          </aliases>
          <extensions>
            <type:TextEntity value=".bml" />
          </extensions>
          <brackets>
            <contrib:CharacterPair bml:id="bracketAngle">
              <open>&lt;</open>
              <close>&gt;</close>
            </contrib:CharacterPair>
            <contrib:CharacterPair bml:id="bracketCurly">
              <open>{</open>
              <close>}</close>
            </contrib:CharacterPair>
            <contrib:CharacterPair bml:id="bracketParen">
              <open>(</open>
              <close>)</close>
            </contrib:CharacterPair>
            <contrib:CharacterPair bml:id="bracketSquare">
              <open>[</open>
              <close>]</close>
            </contrib:CharacterPair>
          </brackets>
          <autoClosingPairs>
            <contrib:CharacterPair bml:id="autoAngle">
              <open>&lt;</open>
              <close>&gt;</close>
            </contrib:CharacterPair>
            <contrib:CharacterPair bml:id="autoDoubleQuote">
              <open>"</open>
              <close>"</close>
            </contrib:CharacterPair>
            <contrib:CharacterPair bml:id="autoSingleQuote">
              <open>'</open>
              <close>'</close>
            </contrib:CharacterPair>
            <contrib:CharacterPair bml:id="autoCurly">
              <open>{</open>
              <close>}</close>
            </contrib:CharacterPair>
            <contrib:CharacterPair bml:id="autoParen">
              <open>(</open>
              <close>)</close>
            </contrib:CharacterPair>
            <contrib:CharacterPair bml:id="autoSquare">
              <open>[</open>
              <close>]</close>
            </contrib:CharacterPair>
            <contrib:CharacterPair bml:id="autoBlockComment">
              <open>&lt;!--</open>
              <close>--&gt;</close>
            </contrib:CharacterPair>
          </autoClosingPairs>
          <surroundingPairs>
            <contrib:CharacterPair bml:id="surroundAngle">
              <open>&lt;</open>
              <close>&gt;</close>
            </contrib:CharacterPair>
            <contrib:CharacterPair bml:id="surroundDoubleQuote">
              <open>"</open>
              <close>"</close>
            </contrib:CharacterPair>
            <contrib:CharacterPair bml:id="surroundSingleQuote">
              <open>'</open>
              <close>'</close>
            </contrib:CharacterPair>
            <contrib:CharacterPair bml:id="surroundCurly">
              <open>{</open>
              <close>}</close>
            </contrib:CharacterPair>
            <contrib:CharacterPair bml:id="surroundParen">
              <open>(</open>
              <close>)</close>
            </contrib:CharacterPair>
            <contrib:CharacterPair bml:id="surroundSquare">
              <open>[</open>
              <close>]</close>
            </contrib:CharacterPair>
          </surroundingPairs>
        </contrib:LanguageContribution>

        <contrib:GrammarContribution bml:id="bmlSimpleGrammar">
          <milestone>V1</milestone>
          <enabled>true</enabled>
          <languageId>bml</languageId>
          <scopeName>source.bml</scopeName>
          <path>./syntaxes/bml.tmLanguage.json</path>
          <embeddedLanguagesNote>CDATA and capability implementation bodies may embed PseudoCode or other dialects later; V1 treats them as plain text/string scopes.</embeddedLanguagesNote>
          <highlightScheme>theme:FrameworkRoles</highlightScheme>
          <scopes>
            <type:TextEntity value="comment.block.bml" />
            <type:TextEntity value="meta.tag.bml" />
            <type:TextEntity value="entity.name.type.framework.root.bml" />
            <type:TextEntity value="keyword.other.block-declaration.bml" />
            <type:TextEntity value="support.type.block-facet.bml" />
            <type:TextEntity value="keyword.other.block-container.bml" />
            <type:TextEntity value="keyword.other.member-container.bml" />
            <type:TextEntity value="entity.name.member.bml" />
            <type:TextEntity value="keyword.other.member-field.bml" />
            <type:TextEntity value="support.type.member-facet.bml" />
            <type:TextEntity value="keyword.other.member-subcontainer.bml" />
            <type:TextEntity value="entity.name.type.bml" />
            <type:TextEntity value="entity.name.type.instance.bml" />
            <type:TextEntity value="entity.name.tag.bml" />
            <type:TextEntity value="entity.other.attribute-name.bml" />
            <type:TextEntity value="string.quoted.double.bml" />
            <type:TextEntity value="string.quoted.single.bml" />
            <type:TextEntity value="keyword.other.interpolation.bml" />
            <type:TextEntity value="keyword.control.embed.bml" />
            <type:TextEntity value="punctuation.definition.comment.bml" />
            <type:TextEntity value="punctuation.definition.tag.bml" />
            <type:TextEntity value="punctuation.separator.key-value.bml" />
          </scopes>
          <patternNotes>
            <type:TextEntity value="Position-based scopes (theme:FrameworkRoles) — same tag name, different color by nesting" />
            <type:TextEntity value="L0 block root — entity.name.type.framework.root.bml" />
            <type:TextEntity value="L1 blockBody: block-declaration (name/type/abstract/…) + block-facet (documentation/summary/…) + block-container (subBlocks/…) + member-container (properties/aggregations/associations/…)" />
            <type:TextEntity value="L2 memberContainerBody: every direct child is a user member name (entity.name.member.bml) — including names that collide with containers (properties/aggregations) or Library aggregations (dependencies, blocks, readMe). Containers wrap until the matching &lt;/same-name&gt;." />
            <type:TextEntity value="L3 memberBody: member-field (type/override/abstract/…) + member-facet (documentation/value/…) + member-subcontainer (composition/suggestions/…)" />
            <type:TextEntity value="L4 memberSubContainerBody: PascalCase composition instances — entity.name.type.instance.bml" />
            <type:TextEntity value="Nested &lt;block&gt; in subBlocks re-enters blockBody (same L1 rules)" />
            <type:TextEntity value="Block-level PascalCase type refs — entity.name.type.bml" />
            <type:TextEntity value="Attribute names — entity.other.attribute-name.bml (V1: no framework attribute whitelist)" />
          </patternNotes>
          <topLevelIncludes>
            <type:TextEntity value="comment" />
            <type:TextEntity value="expression" />
            <type:TextEntity value="embed" />
            <type:TextEntity value="block" />
            <type:TextEntity value="tagRoot" />
            <type:TextEntity value="tagBlockDeclaration" />
            <type:TextEntity value="tagBlockFacet" />
            <type:TextEntity value="tagBlockContainer" />
            <type:TextEntity value="tagMemberContainer" />
            <type:TextEntity value="tagDomainType" />
            <type:TextEntity value="tag" />
          </topLevelIncludes>
          <patterns>
            <contrib:GrammarPattern bml:id="patternComment">
              <patternKey>comment</patternKey>
              <scopeName>comment.block.bml</scopeName>
              <begin>&lt;!--</begin>
              <end>--&gt;</end>
              <beginCapturesJson>{"0":{"name":"punctuation.definition.comment.bml"}}</beginCapturesJson>
              <endCapturesJson>{"0":{"name":"punctuation.definition.comment.bml"}}</endCapturesJson>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternExpression">
              <patternKey>expression</patternKey>
              <scopeName>keyword.other.interpolation.bml</scopeName>
              <begin>\$\{</begin>
              <end>\}</end>
              <beginCapturesJson>{"0":{"name":"punctuation.definition.interpolation.begin.bml"}}</beginCapturesJson>
              <endCapturesJson>{"0":{"name":"punctuation.definition.interpolation.end.bml"}}</endCapturesJson>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternEmbed">
              <patternKey>embed</patternKey>
              <scopeName>keyword.control.embed.bml</scopeName>
              <begin>&lt;\$</begin>
              <end>\$&gt;</end>
              <beginCapturesJson>{"0":{"name":"punctuation.definition.embed.begin.bml"}}</beginCapturesJson>
              <endCapturesJson>{"0":{"name":"punctuation.definition.embed.end.bml"}}</endCapturesJson>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternDoubleQuoted">
              <patternKey>stringDouble</patternKey>
              <scopeName>string.quoted.double.bml</scopeName>
              <begin>"</begin>
              <end>"</end>
              <nestedIncludes>
                <type:TextEntity value="#expression" />
                <type:TextEntity value="#embed" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternSingleQuoted">
              <patternKey>stringSingle</patternKey>
              <scopeName>string.quoted.single.bml</scopeName>
              <begin>'</begin>
              <end>'</end>
              <nestedIncludes>
                <type:TextEntity value="#expression" />
                <type:TextEntity value="#embed" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternAttribute">
              <patternKey>attribute</patternKey>
              <match>\s+([A-Za-z_:][\w:.-]*)(\s*=\s*)(?:(")([^"]*)(")|(')([^']*)('))?</match>
              <capturesJson>{"1":{"name":"entity.other.attribute-name.bml"},"2":{"name":"punctuation.separator.key-value.bml"},"3":{"name":"punctuation.definition.string.begin.bml"},"4":{"name":"string.quoted.double.bml"},"5":{"name":"punctuation.definition.string.end.bml"},"6":{"name":"punctuation.definition.string.begin.bml"},"7":{"name":"string.quoted.single.bml"},"8":{"name":"punctuation.definition.string.end.bml"}}</capturesJson>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternBlock">
              <patternKey>block</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;)(block)(?=[\s/>])</begin>
              <end>(/?&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.type.framework.root.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
                <type:TextEntity value="#blockBody" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternBlockBody">
              <patternKey>blockBody</patternKey>
              <includeRef>#tagBlockDeclarationElement</includeRef>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternMemberTypeElement">
              <patternKey>memberTypeElement</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;)((?:[A-Za-z_][\w.-]*:)?[A-Z][a-zA-Z0-9]*)(?=[\s/>])</begin>
              <end>(/?&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.member.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
                <type:TextEntity value="#memberBody" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternDomainTypeElement">
              <patternKey>domainTypeElement</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;)((?:[A-Za-z_][\w.-]*:)?[A-Z][a-zA-Z0-9]*)(?=[\s/>])</begin>
              <end>(/?&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.type.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternCloseTagDomainType">
              <patternKey>closeTagDomainType</patternKey>
              <match>(&lt;/)((?:[A-Za-z_][\w.-]*:)?[A-Z][a-zA-Z0-9]*)(\s*(>))</match>
              <capturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.type.bml"},"3":{"name":"punctuation.definition.tag.bml"}}</capturesJson>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternMemberElement">
              <patternKey>memberElement</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;)((?:[A-Za-z_][\w.-]*:)?[a-z_][\w.-]*)(?=[\s/>])</begin>
              <end>(/?&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.member.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
                <type:TextEntity value="#memberBody" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternTagMemberContainerElement">
              <patternKey>tagMemberContainerElement</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;)(properties|aggregations|associations|capabilities|constraints)(?=[\s/>])</begin>
              <end>(/&gt;)|(&lt;/)(\2)\s*(&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"keyword.other.member-container.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"punctuation.definition.tag.bml"},"3":{"name":"keyword.other.member-container.bml"},"4":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
                <type:TextEntity value="#memberContainerBody" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternTagBlockContainerElement">
              <patternKey>tagBlockContainerElement</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;)(contracts|subBlocks|embeddedBlocks|composition|genericTypes|groups|aliases|keywords|references)(?=[\s/>])</begin>
              <end>(/&gt;)|(&lt;/)(\2)\s*(&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"keyword.other.block-container.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"punctuation.definition.tag.bml"},"3":{"name":"keyword.other.block-container.bml"},"4":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
                <type:TextEntity value="#blockContainerBody" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternTagBlockDeclarationElement">
              <patternKey>tagBlockDeclarationElement</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;)(name|type|baseType|is|isnot|version|abstract|final|definition|language)(?=[\s/>])</begin>
              <end>(/?&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"keyword.other.block-declaration.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternTagBlockFacetElement">
              <patternKey>tagBlockFacetElement</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;)(documentation|summary|status|since|changelog|examples|relation|see|content|description|title|bml:xml|bml:container|implementation)(?=[\s/>])</begin>
              <end>(/?&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"support.type.block-facet.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternTagMemberFieldIdentityElement">
              <patternKey>tagMemberFieldIdentityElement</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;)(type|abstract|final|override|readOnly|visibility|default)(?=[\s/>])</begin>
              <end>(/?&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"keyword.other.member-field.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternTagMemberFieldFacetElement">
              <patternKey>tagMemberFieldFacetElement</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;)(value|documentation|summary|implementation|inputType|outputType|status|since|changelog|examples|relation|see|content|description|title|bml:xml|bml:container)(?=[\s/>])</begin>
              <end>(/?&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"support.type.member-facet.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternTagRoot">
              <patternKey>tagRoot</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;/?)(block)(?=[\s/>])</begin>
              <end>(/?&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.type.framework.root.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternTagBlockDeclaration">
              <patternKey>tagBlockDeclaration</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;/?)(name|type|baseType|is|isnot|version|abstract|final|definition|language)(?=[\s/>])</begin>
              <end>(/?&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"keyword.other.block-declaration.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternTagBlockContainer">
              <patternKey>tagBlockContainer</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;/?)(contracts|subBlocks|embeddedBlocks|composition|genericTypes|groups|aliases|keywords|references)(?=[\s/>])</begin>
              <end>(/?&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"keyword.other.block-container.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternTagMemberContainer">
              <patternKey>tagMemberContainer</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;/?)(properties|aggregations|associations|capabilities|constraints)(?=[\s/>])</begin>
              <end>(/?&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"keyword.other.member-container.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternTagBlockFacet">
              <patternKey>tagBlockFacet</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;/?)(documentation|summary|status|since|changelog|examples|relation|see|content|description|title|bml:xml|bml:container|implementation)(?=[\s/>])</begin>
              <end>(/?&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"support.type.block-facet.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternTagDomainType">
              <patternKey>tagDomainType</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;/?)((?:[A-Za-z_][\w.-]*:)?[A-Z][a-zA-Z0-9]*)(?=[\s/>])</begin>
              <end>(/?&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.type.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
              </nestedIncludes>
            </contrib:GrammarPattern>

            <contrib:GrammarPattern bml:id="patternTag">
              <patternKey>tag</patternKey>
              <scopeName>meta.tag.bml</scopeName>
              <begin>(&lt;/?)((?:[A-Za-z_][\w.-]*:)?[a-z_][\w.-]*)</begin>
              <end>(/?&gt;)</end>
              <beginCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"},"2":{"name":"entity.name.tag.bml"}}</beginCapturesJson>
              <endCapturesJson>{"1":{"name":"punctuation.definition.tag.bml"}}</endCapturesJson>
              <nestedIncludes>
                <type:TextEntity value="#attribute" />
              </nestedIncludes>
            </contrib:GrammarPattern>
          </patterns>
        </contrib:GrammarContribution>

        <contrib:IconContribution bml:id="bmlFileIcon">
          <milestone>V1</milestone>
          <enabled>true</enabled>
          <languageId>bml</languageId>
          <iconPath>./icons/blockml.svg</iconPath>
          <contributeLanguageIcon>true</contributeLanguageIcon>
          <contributeIconTheme>false</contributeIconTheme>
          <fileExtension>.bml</fileExtension>
          <themeId>blockml-icons</themeId>
          <themeLabel>BlockML Icons</themeLabel>
          <themePath>./icons/blockml-icon-theme.json</themePath>
          <iconDefinitionId>bml_file</iconDefinitionId>
        </contrib:IconContribution>

        <contrib:ColorThemeContribution bml:id="bmlDevColorTheme">
          <milestone>V1</milestone>
          <enabled>true</enabled>
          <marketplace>false</marketplace>
          <contributeTheme>false</contributeTheme>
          <overlayTokenColors>true</overlayTokenColors>
          <overlaySemanticTokenColors>true</overlaySemanticTokenColors>
          <colorTheme>theme:BlockMlDevColorTheme</colorTheme>
        </contrib:ColorThemeContribution>

        <contrib:ConfigurationContribution bml:id="blockmlConfiguration">
          <milestone>V1</milestone>
          <enabled>true</enabled>
          <title>BlockML</title>
          <settings>

            <contrib:Setting bml:id="traceServer">
              <key>blockml.bml.trace.server</key>
              <valueKind>String</valueKind>
              <defaultValue>off</defaultValue>
              <description>Traces the communication between VS Code and the BlockML language server.</description>
              <scope>Window</scope>
              <enumValues>
                <type:TextEntity value="off" />
                <type:TextEntity value="messages" />
                <type:TextEntity value="verbose" />
              </enumValues>
            </contrib:Setting>

            <contrib:Setting bml:id="enableLanguageServer">
              <key>blockml.bml.enableLanguageServer</key>
              <valueKind>Boolean</valueKind>
              <defaultValue>true</defaultValue>
              <description>Enable the BlockML language server client for diagnostics.</description>
              <scope>Window</scope>
            </contrib:Setting>

            <contrib:Setting bml:id="enableSemanticHighlighting">
              <key>blockml.bml.enableSemanticHighlighting</key>
              <valueKind>Boolean</valueKind>
              <defaultValue>true</defaultValue>
              <description>Enable semantic highlighting on top of the TextMate grammar (V2). Uses the BlockML classifier locally so nested files keep position-based colors.</description>
              <scope>Window</scope>
            </contrib:Setting>

          </settings>
        </contrib:ConfigurationContribution>

        <!-- ========== V2 ========== -->

        <contrib:LanguageServerContribution bml:id="bmlLanguageServer">
          <milestone>V2</milestone>
          <enabled>true</enabled>
          <serverModulePath>node_modules/@blockml/lsp/dist/server.js</serverModulePath>
          <transport>stdio</transport>
          <debugPort>6009</debugPort>
          <traceSettingKey>blockml.bml.trace.server</traceSettingKey>
          <documentSelectors>
            <type:TextEntity value="language:bml" />
            <type:TextEntity value="scheme:file" />
            <type:TextEntity value="pattern:**/*.bml" />
          </documentSelectors>
          <clientFeatures>
            <type:TextEntity value="diagnostics" />
            <type:TextEntity value="hover" />
            <type:TextEntity value="documentSymbol" />
            <type:TextEntity value="definition" />
            <type:TextEntity value="references" />
            <type:TextEntity value="semanticTokens" />
          </clientFeatures>
        </contrib:LanguageServerContribution>

        <contrib:GrammarContribution bml:id="bmlAdvancedGrammar">
          <milestone>V2</milestone>
          <enabled>true</enabled>
          <languageId>bml</languageId>
          <scopeName>source.bml</scopeName>
          <path>./syntaxes/bml.tmLanguage.json</path>
          <embeddedLanguagesNote>V2 extends V1 patterns with type-reference-looking QNames, bml:* directives, and clearer member/property name scopes; semantic tokens refine further.</embeddedLanguagesNote>
          <scopes>
            <type:TextEntity value="entity.name.type.bml" />
            <type:TextEntity value="entity.name.namespace.bml" />
            <type:TextEntity value="keyword.control.directive.bml" />
            <type:TextEntity value="variable.other.member.bml" />
            <type:TextEntity value="support.type.property-name.bml" />
          </scopes>
          <patternNotes>
            <type:TextEntity value="Prefixed type references (core:Block, type:Text, …)" />
            <type:TextEntity value="bml:id / bml:version / bml:each / bml:if / bml:xml directive attributes" />
            <type:TextEntity value="Member element names under properties/aggregations/associations/capabilities" />
          </patternNotes>
        </contrib:GrammarContribution>

        <contrib:SemanticHighlightingContribution bml:id="bmlSemanticHighlighting">
          <milestone>V2</milestone>
          <enabled>true</enabled>
          <viaLanguageServer>true</viaLanguageServer>
          <tokenTypes>
            <type:TextEntity value="root" />
            <type:TextEntity value="blockDeclaration" />
            <type:TextEntity value="blockFacet" />
            <type:TextEntity value="blockContainer" />
            <type:TextEntity value="memberContainer" />
            <type:TextEntity value="memberName" />
            <type:TextEntity value="memberField" />
            <type:TextEntity value="memberFacet" />
            <type:TextEntity value="memberSubContainer" />
            <type:TextEntity value="domainType" />
            <type:TextEntity value="compositionInstance" />
            <type:TextEntity value="tag" />
            <type:TextEntity value="attribute" />
            <type:TextEntity value="stringDouble" />
            <type:TextEntity value="stringSingle" />
            <type:TextEntity value="blockComment" />
            <type:TextEntity value="interpolation" />
            <type:TextEntity value="embed" />
            <type:TextEntity value="tagPunctuation" />
            <type:TextEntity value="commentPunctuation" />
            <type:TextEntity value="attributeSeparator" />
          </tokenTypes>
        </contrib:SemanticHighlightingContribution>

        <contrib:NavigationContribution bml:id="bmlNavigation">
          <milestone>V2</milestone>
          <enabled>true</enabled>
          <preferLanguageServer>true</preferLanguageServer>
          <ctrlClickEnabled>true</ctrlClickEnabled>
          <kinds>
            <type:TextEntity value="BlockType" />
            <type:TextEntity value="BaseType" />
            <type:TextEntity value="Property" />
            <type:TextEntity value="Aggregation" />
            <type:TextEntity value="Association" />
            <type:TextEntity value="Capability" />
            <type:TextEntity value="ReferenceSee" />
            <type:TextEntity value="InstanceId" />
            <type:TextEntity value="NamespacePrefix" />
          </kinds>
          <gestures>
            <type:TextEntity value="goToDefinition" />
            <type:TextEntity value="peekDefinition" />
            <type:TextEntity value="findReferences" />
            <type:TextEntity value="goToTypeDefinition" />
          </gestures>
        </contrib:NavigationContribution>

        <contrib:CommandContribution bml:id="goToDefinitionCommand">
          <milestone>V2</milestone>
          <enabled>true</enabled>
          <commandId>blockml.bml.goToDefinition</commandId>
          <title>Go to Definition</title>
          <category>BlockML</category>
        </contrib:CommandContribution>

        <contrib:CommandContribution bml:id="peekDefinitionCommand">
          <milestone>V2</milestone>
          <enabled>true</enabled>
          <commandId>blockml.bml.peekDefinition</commandId>
          <title>Peek Definition</title>
          <category>BlockML</category>
        </contrib:CommandContribution>

        <contrib:CommandContribution bml:id="findReferencesCommand">
          <milestone>V2</milestone>
          <enabled>true</enabled>
          <commandId>blockml.bml.findReferences</commandId>
          <title>Find All References</title>
          <category>BlockML</category>
        </contrib:CommandContribution>

        <contrib:KeybindingContribution bml:id="goToDefinitionKey">
          <milestone>V2</milestone>
          <enabled>true</enabled>
          <commandId>blockml.bml.goToDefinition</commandId>
          <key>f12</key>
          <when>editorLangId == 'bml'</when>
        </contrib:KeybindingContribution>

        <contrib:KeybindingContribution bml:id="peekDefinitionKey">
          <milestone>V2</milestone>
          <enabled>true</enabled>
          <commandId>blockml.bml.peekDefinition</commandId>
          <key>alt+f12</key>
          <when>editorLangId == 'bml'</when>
        </contrib:KeybindingContribution>

        <contrib:KeybindingContribution bml:id="findReferencesKey">
          <milestone>V2</milestone>
          <enabled>true</enabled>
          <commandId>blockml.bml.findReferences</commandId>
          <key>shift+f12</key>
          <when>editorLangId == 'bml'</when>
        </contrib:KeybindingContribution>
      </composition>
    </contributions>
  </aggregations>

</block>

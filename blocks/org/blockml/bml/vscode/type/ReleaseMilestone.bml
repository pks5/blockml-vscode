<!--BlockML VS Code — release milestone enum

  FQN: org.blockml.bml.vscode.type.ReleaseMilestone-->
<vtype:ReleaseMilestone xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:type="org.blockml.bml.type"
  xmlns:vtype="org.blockml.bml.vscode.type">

  <baseType>
    type:EnumType
  </baseType>
  <is>
    A plugin release milestone
  </is>
  <documentation>
    Closed set of BlockML VS Code extension roadmap slices. Contributions declare
    milestone V1 or V2 so documentation and generators stay aligned.
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <vtype:ReleaseMilestone bml:id="V1" />
        <vtype:ReleaseMilestone bml:id="V2" />
      </composition>
    </values>
  </aggregations>
</vtype:ReleaseMilestone>

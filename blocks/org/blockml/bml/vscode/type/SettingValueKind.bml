<!--BlockML VS Code — setting value kind enum

  FQN: org.blockml.bml.vscode.type.SettingValueKind-->
<vtype:SettingValueKind xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:type="org.blockml.bml.type"
  xmlns:vtype="org.blockml.bml.vscode.type">

  <baseType>
    type:EnumType
  </baseType>
  <is>
    A VS Code setting JSON schema type
  </is>
  <documentation>
    Maps to contributes.configuration property type values used in package.json
    configuration schemas.
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <vtype:SettingValueKind bml:id="Boolean" />
        <vtype:SettingValueKind bml:id="String" />
        <vtype:SettingValueKind bml:id="Number" />
        <vtype:SettingValueKind bml:id="Integer" />
        <vtype:SettingValueKind bml:id="Array" />
        <vtype:SettingValueKind bml:id="Object" />
      </composition>
    </values>
  </aggregations>
</vtype:SettingValueKind>

<!--BlockML VS Code — navigation kind enum

  FQN: org.blockml.bml.vscode.type.NavigationKind-->
<vtype:NavigationKind xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:type="org.blockml.bml.type"
  xmlns:vtype="org.blockml.bml.vscode.type">

  <baseType>
    type:EnumType
  </baseType>
  <is>
    A BML symbol navigation kind
  </is>
  <documentation>
    Kinds of click-to-navigate targets between BML files — analogous to Java class,
    field, and method navigation. Used by NavigationContribution and LSP go-to-definition
    providers.
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <vtype:NavigationKind bml:id="BlockType" />
        <vtype:NavigationKind bml:id="BaseType" />
        <vtype:NavigationKind bml:id="Property" />
        <vtype:NavigationKind bml:id="Aggregation" />
        <vtype:NavigationKind bml:id="Association" />
        <vtype:NavigationKind bml:id="Capability" />
        <vtype:NavigationKind bml:id="ReferenceSee" />
        <vtype:NavigationKind bml:id="InstanceId" />
        <vtype:NavigationKind bml:id="NamespacePrefix" />
      </composition>
    </values>
  </aggregations>
</vtype:NavigationKind>

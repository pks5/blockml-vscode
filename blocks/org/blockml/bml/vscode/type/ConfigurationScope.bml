<!--BlockML VS Code — configuration scope enum

  FQN: org.blockml.bml.vscode.type.ConfigurationScope-->
<vtype:ConfigurationScope xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:type="org.blockml.bml.type"
  xmlns:vtype="org.blockml.bml.vscode.type">

  <baseType>
    type:EnumType
  </baseType>
  <is>
    A VS Code configuration scope
  </is>
  <documentation>
    Maps to VS Code ConfigurationScope for contributes.configuration properties
    (application, machine, window, resource, language-overridable).
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <vtype:ConfigurationScope bml:id="Application" />
        <vtype:ConfigurationScope bml:id="Machine" />
        <vtype:ConfigurationScope bml:id="Window" />
        <vtype:ConfigurationScope bml:id="Resource" />
        <vtype:ConfigurationScope bml:id="LanguageOverridable" />
      </composition>
    </values>
  </aggregations>
</vtype:ConfigurationScope>

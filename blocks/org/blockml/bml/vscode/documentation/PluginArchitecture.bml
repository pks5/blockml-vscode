<!--
  BlockML VS Code — documentation

  FQN: org.blockml.bml.vscode.documentation.PluginArchitecture
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:contrib="org.blockml.bml.vscode.contribution"
  xmlns:doc="org.blockml.bml.vscode.documentation"
  xmlns:theme="org.blockml.bml.vscode.theme"
  xmlns:vscode="org.blockml.bml.vscode">

  <name>PluginArchitecture</name>
  <type>doc:PluginArchitecture</type>
  <baseType>core:Documentation</baseType>
  <is>A guide to the VS Code plugin BML model</is>

  <documentation>
    Package layout under org.blockml.bml.vscode:
    • vscode.Extension — abstract extension descriptor (publisher, engines, activation, contributions)
    • vscode.contribution.* — Contribution branch (Language, Grammar, Icon, Configuration/Setting,
      Command, Keybinding, LanguageServer, Navigation, SemanticHighlighting) plus supporting
      entities CharacterPair and GrammarPattern
    • vscode.theme.* — semantic highlight schemes (HighlightScheme, HighlightRole, FrameworkRoles)
      that drive framework vs domain tag TextMate scopes, plus ColorTheme / TokenColorRule /
      BlockMlDevColorTheme for the shipped Marketplace color theme
    • vscode.type.* — closed enums (ReleaseMilestone, SettingValueKind, ConfigurationScope,
      NavigationKind)
    • vscode.documentation.* — curated reading material for this library
    • vscode.BlockMlExtension — concrete BlockML plugin filled with V1 and V2 contributions

    Every contribution carries milestone V1 or V2 and enabled. Generators filter by milestone
    when producing a V1-only build or a full V2 build.

    Membership of published types is exclusive to Library.bml blocks — directory layout is
    authoring convenience only.
  </documentation>

  <references>
    <see type="doc:ContributionModel" relation="ReadNext">
      Next — contribution taxonomy and package.json mapping.
    </see>
    <see type="vscode:Extension" relation="Defines">
      Extension root type.
    </see>
    <see type="contrib:Contribution" relation="Defines">
      Abstract contribution branch.
    </see>
    <see type="theme:HighlightScheme" relation="SeeAlso">
      Semantic highlight scheme packages under vscode.theme.*.
    </see>
    <see type="doc:Introduction" relation="SeeAlso">
      Library goals and generation workflow overview.
    </see>
  </references>

</block>

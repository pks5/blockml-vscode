<!--
  BlockML VS Code — shipped color theme (position-based scope colors)

  FQN: org.blockml.bml.vscode.theme.BlockMlDevColorTheme
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:theme="org.blockml.bml.vscode.theme">

  <name>BlockMlDevColorTheme</name>
  <type>theme:BlockMlDevColorTheme</type>
  <baseType>theme:ColorTheme</baseType>
  <is>The BlockML color theme</is>

  <summary>Shipped Marketplace theme: one distinct color per position-based BML scope (block /
    container / member / field). Required for visible syntax highlighting — generic themes do not
    paint the *.bml scopes.</summary>

  <properties>
    <themeId><value>blockml</value></themeId>
    <label><value>BlockML</value></label>
    <uiTheme><value>vs-dark</value></uiTheme>
    <themePath><value>./themes/blockml-color-theme.json</value></themePath>
    <highlightScheme><value>theme:FrameworkRoles</value></highlightScheme>
    <editorForeground><value>#D4D4D4</value></editorForeground>
    <editorBackground><value>#1E1E1E</value></editorBackground>
  </properties>

  <aggregations>
    <tokenColors>

      <theme:TokenColorRule bml:id="colorRoot">
        <ruleName><value>BML L0: block root</value></ruleName>
        <scope><value>entity.name.type.framework.root.bml</value></scope>
        <foreground><value>#FF79C6</value></foreground>
        <fontStyle><value>bold</value></fontStyle>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorBlockDeclaration">
        <ruleName><value>BML L1: block declaration (name, type, abstract, …)</value></ruleName>
        <scope><value>keyword.other.block-declaration.bml</value></scope>
        <foreground><value>#C586C0</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorBlockFacet">
        <ruleName><value>BML L1: block facet (documentation, summary, …)</value></ruleName>
        <scope><value>support.type.block-facet.bml</value></scope>
        <foreground><value>#6A9955</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorBlockContainer">
        <ruleName><value>BML L1: block container (subBlocks, references, …)</value></ruleName>
        <scope><value>keyword.other.block-container.bml</value></scope>
        <foreground><value>#3794FF</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorMemberContainer">
        <ruleName><value>BML L1: member container (properties, aggregations, associations)</value></ruleName>
        <scope><value>keyword.other.member-container.bml</value></scope>
        <foreground><value>#4EC9B0</value></foreground>
        <fontStyle><value>bold</value></fontStyle>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorMemberName">
        <ruleName><value>BML L2: member name (user property / aggregation / association)</value></ruleName>
        <scope><value>entity.name.member.bml</value></scope>
        <foreground><value>#CE9178</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorMemberField">
        <ruleName><value>BML L3: member field identity (type, override, abstract, …)</value></ruleName>
        <scope><value>keyword.other.member-field.bml</value></scope>
        <foreground><value>#BB86FC</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorMemberFacet">
        <ruleName><value>BML L3: member field facet (documentation, value, …)</value></ruleName>
        <scope><value>support.type.member-facet.bml</value></scope>
        <foreground><value>#98C379</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorMemberSubContainer">
        <ruleName><value>BML L3: member sub-container (composition, suggestions, …)</value></ruleName>
        <scope><value>keyword.other.member-subcontainer.bml</value></scope>
        <foreground><value>#56B6C2</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorDomainType">
        <ruleName><value>BML: domain type ref (PascalCase at block level)</value></ruleName>
        <scope><value>entity.name.type.bml</value></scope>
        <foreground><value>#DCDCAA</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorCompositionInstance">
        <ruleName><value>BML L4: composition instance (PascalCase in composition)</value></ruleName>
        <scope><value>entity.name.type.instance.bml</value></scope>
        <foreground><value>#E5C07B</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorDomainTag">
        <ruleName><value>BML: fallback tag</value></ruleName>
        <scope><value>entity.name.tag.bml</value></scope>
        <foreground><value>#ABB2BF</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorAttribute">
        <ruleName><value>BML: attribute name</value></ruleName>
        <scope><value>entity.other.attribute-name.bml</value></scope>
        <foreground><value>#9CDCFE</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorStringDouble">
        <ruleName><value>BML: double-quoted string</value></ruleName>
        <scope><value>string.quoted.double.bml</value></scope>
        <foreground><value>#CE9178</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorStringSingle">
        <ruleName><value>BML: single-quoted string</value></ruleName>
        <scope><value>string.quoted.single.bml</value></scope>
        <foreground><value>#D7BA7D</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorComment">
        <ruleName><value>BML: comment</value></ruleName>
        <scope><value>comment.block.bml</value></scope>
        <foreground><value>#608B4E</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorInterpolation">
        <ruleName><value>BML: interpolation</value></ruleName>
        <scope><value>keyword.other.interpolation.bml</value></scope>
        <foreground><value>#D7BA7D</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorEmbed">
        <ruleName><value>BML: embed marker</value></ruleName>
        <scope><value>keyword.control.embed.bml</value></scope>
        <foreground><value>#D16969</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorPunctTag">
        <ruleName><value>BML: tag punctuation</value></ruleName>
        <scope><value>punctuation.definition.tag.bml</value></scope>
        <foreground><value>#808080</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorPunctComment">
        <ruleName><value>BML: comment punctuation</value></ruleName>
        <scope><value>punctuation.definition.comment.bml</value></scope>
        <foreground><value>#608B4E</value></foreground>
      </theme:TokenColorRule>

      <theme:TokenColorRule bml:id="colorPunctKeyValue">
        <ruleName><value>BML: attribute separator</value></ruleName>
        <scope><value>punctuation.separator.key-value.bml</value></scope>
        <foreground><value>#D4D4D4</value></foreground>
      </theme:TokenColorRule>

    </tokenColors>
  </aggregations>

</block>

<!--
  BlockML VS Code — shipped color theme (position-based scope colors)

  FQN: org.blockml.bml.vscode.theme.BlockMlDevColorTheme
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:theme="org.blockml.bml.vscode.theme">

  <name>BlockMlDevColorTheme</name>
  <type>theme:BlockMlDevColorTheme</type>
  <baseType>theme:ColorTheme</baseType>
  <is>The BlockML color theme</is>

  <summary>Shipped Marketplace theme: one distinct color per position-based BML scope (block /
    container / member / field). Required for visible syntax highlighting — generic themes do not
    paint the *.bml scopes.</summary>

  <properties>
    <themeId><value>blockml</value></themeId>
    <label><value>BlockML</value></label>
    <uiTheme><value>vs-dark</value></uiTheme>
    <themePath><value>./themes/blockml-color-theme.json</value></themePath>
    <highlightScheme><value>theme:FrameworkRoles</value></highlightScheme>
    <editorForeground><value>#D4D4D4</value></editorForeground>
    <editorBackground><value>#1E1E1E</value></editorBackground>
  </properties>

  <aggregations>
    <tokenColors>
      <composition>
        <theme:TokenColorRule bml:id="colorRoot">
          <ruleName>BML L0: block root</ruleName>
          <scope>entity.name.type.framework.root.bml</scope>
          <foreground>#FF79C6</foreground>
          <fontStyle>bold</fontStyle>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorBlockDeclaration">
          <ruleName>BML L1: block declaration (name, type, abstract, …)</ruleName>
          <scope>keyword.other.block-declaration.bml</scope>
          <foreground>#C586C0</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorBlockFacet">
          <ruleName>BML L1: block facet (documentation, summary, …)</ruleName>
          <scope>support.type.block-facet.bml</scope>
          <foreground>#6A9955</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorBlockContainer">
          <ruleName>BML L1: block container (subBlocks, references, …)</ruleName>
          <scope>keyword.other.block-container.bml</scope>
          <foreground>#3794FF</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorMemberContainer">
          <ruleName>BML L1: member container (properties, aggregations, associations)</ruleName>
          <scope>keyword.other.member-container.bml</scope>
          <foreground>#4EC9B0</foreground>
          <fontStyle>bold</fontStyle>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorMemberName">
          <ruleName>BML L2: member name (user property / aggregation / association)</ruleName>
          <scope>entity.name.member.bml</scope>
          <foreground>#CE9178</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorMemberField">
          <ruleName>BML L3: member field identity (type, override, abstract, …)</ruleName>
          <scope>keyword.other.member-field.bml</scope>
          <foreground>#BB86FC</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorMemberFacet">
          <ruleName>BML L3: member field facet (documentation, value, …)</ruleName>
          <scope>support.type.member-facet.bml</scope>
          <foreground>#98C379</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorMemberSubContainer">
          <ruleName>BML L3: member sub-container (composition, suggestions, …)</ruleName>
          <scope>keyword.other.member-subcontainer.bml</scope>
          <foreground>#56B6C2</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorDomainType">
          <ruleName>BML: domain type ref (PascalCase at block level)</ruleName>
          <scope>entity.name.type.bml</scope>
          <foreground>#DCDCAA</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorCompositionInstance">
          <ruleName>BML L4: composition instance (PascalCase in composition)</ruleName>
          <scope>entity.name.type.instance.bml</scope>
          <foreground>#E5C07B</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorDomainTag">
          <ruleName>BML: fallback tag</ruleName>
          <scope>entity.name.tag.bml</scope>
          <foreground>#ABB2BF</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorAttribute">
          <ruleName>BML: attribute name</ruleName>
          <scope>entity.other.attribute-name.bml</scope>
          <foreground>#9CDCFE</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorStringDouble">
          <ruleName>BML: double-quoted string</ruleName>
          <scope>string.quoted.double.bml</scope>
          <foreground>#CE9178</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorStringSingle">
          <ruleName>BML: single-quoted string</ruleName>
          <scope>string.quoted.single.bml</scope>
          <foreground>#D7BA7D</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorComment">
          <ruleName>BML: comment</ruleName>
          <scope>comment.block.bml</scope>
          <foreground>#608B4E</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorInterpolation">
          <ruleName>BML: interpolation</ruleName>
          <scope>keyword.other.interpolation.bml</scope>
          <foreground>#D7BA7D</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorEmbed">
          <ruleName>BML: embed marker</ruleName>
          <scope>keyword.control.embed.bml</scope>
          <foreground>#D16969</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorPunctTag">
          <ruleName>BML: tag punctuation</ruleName>
          <scope>punctuation.definition.tag.bml</scope>
          <foreground>#808080</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorPunctComment">
          <ruleName>BML: comment punctuation</ruleName>
          <scope>punctuation.definition.comment.bml</scope>
          <foreground>#608B4E</foreground>
        </theme:TokenColorRule>

        <theme:TokenColorRule bml:id="colorPunctKeyValue">
          <ruleName>BML: attribute separator</ruleName>
          <scope>punctuation.separator.key-value.bml</scope>
          <foreground>#D4D4D4</foreground>
        </theme:TokenColorRule>
      </composition>
    </tokenColors>
  </aggregations>

</block>

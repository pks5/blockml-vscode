{
  "$schema": "vscode://schemas/color-theme",
  "name": "BlockML",
  "type": "dark",
  "colors": {
    "editor.foreground": "#D4D4D4",
    "editor.background": "#1E1E1E"
  },
  "tokenColors": [
    {
      "name": "BML L0: block root",
      "scope": "entity.name.type.framework.root.bml",
      "settings": { "foreground": "#FF79C6", "fontStyle": "bold" }
    },
    {
      "name": "BML L1: block declaration (name, type, abstract, …)",
      "scope": "keyword.other.block-declaration.bml",
      "settings": { "foreground": "#C586C0" }
    },
    {
      "name": "BML L1: block facet (documentation, summary, …)",
      "scope": "support.type.block-facet.bml",
      "settings": { "foreground": "#6A9955" }
    },
    {
      "name": "BML L1: block container (subBlocks, references, …)",
      "scope": "keyword.other.block-container.bml",
      "settings": { "foreground": "#3794FF" }
    },
    {
      "name": "BML L1: member container (properties, aggregations, associations)",
      "scope": "keyword.other.member-container.bml",
      "settings": { "foreground": "#4EC9B0", "fontStyle": "bold" }
    },
    {
      "name": "BML L2: member name (user property / aggregation / association)",
      "scope": "entity.name.member.bml",
      "settings": { "foreground": "#CE9178" }
    },
    {
      "name": "BML L3: member field identity (type, override, abstract, …)",
      "scope": "keyword.other.member-field.bml",
      "settings": { "foreground": "#BB86FC" }
    },
    {
      "name": "BML L3: member field facet (documentation, value, …)",
      "scope": "support.type.member-facet.bml",
      "settings": { "foreground": "#98C379" }
    },
    {
      "name": "BML L3: member sub-container (composition, suggestions, …)",
      "scope": "keyword.other.member-subcontainer.bml",
      "settings": { "foreground": "#56B6C2" }
    },
    {
      "name": "BML: domain type ref (PascalCase at block level)",
      "scope": "entity.name.type.bml",
      "settings": { "foreground": "#DCDCAA" }
    },
    {
      "name": "BML L4: composition instance (PascalCase in composition)",
      "scope": "entity.name.type.instance.bml",
      "settings": { "foreground": "#E5C07B" }
    },
    {
      "name": "BML: fallback tag",
      "scope": "entity.name.tag.bml",
      "settings": { "foreground": "#ABB2BF" }
    },
    {
      "name": "BML: attribute name",
      "scope": "entity.other.attribute-name.bml",
      "settings": { "foreground": "#9CDCFE" }
    },
    {
      "name": "BML: double-quoted string",
      "scope": "string.quoted.double.bml",
      "settings": { "foreground": "#CE9178" }
    },
    {
      "name": "BML: single-quoted string",
      "scope": "string.quoted.single.bml",
      "settings": { "foreground": "#D7BA7D" }
    },
    {
      "name": "BML: comment",
      "scope": "comment.block.bml",
      "settings": { "foreground": "#608B4E" }
    },
    {
      "name": "BML: interpolation",
      "scope": "keyword.other.interpolation.bml",
      "settings": { "foreground": "#D7BA7D" }
    },
    {
      "name": "BML: embed marker",
      "scope": "keyword.control.embed.bml",
      "settings": { "foreground": "#D16969" }
    },
    {
      "name": "BML: tag punctuation",
      "scope": "punctuation.definition.tag.bml",
      "settings": { "foreground": "#808080" }
    },
    {
      "name": "BML: comment punctuation",
      "scope": "punctuation.definition.comment.bml",
      "settings": { "foreground": "#608B4E" }
    },
    {
      "name": "BML: attribute separator",
      "scope": "punctuation.separator.key-value.bml",
      "settings": { "foreground": "#D4D4D4" }
    },
    {
      "name": "XML/XSD: tag name",
      "scope": "entity.name.tag.xml",
      "settings": { "foreground": "#569CD6" }
    },
    {
      "name": "XML/XSD: attribute name",
      "scope": "entity.other.attribute-name.xml",
      "settings": { "foreground": "#9CDCFE" }
    },
    {
      "name": "XML/XSD: string",
      "scope": "string.quoted.double.xml",
      "settings": { "foreground": "#CE9178" }
    },
    {
      "name": "XML/XSD: comment",
      "scope": "comment.block.xml",
      "settings": { "foreground": "#6A9955" }
    },
    {
      "name": "XML/XSD: tag punctuation",
      "scope": "punctuation.definition.tag.xml",
      "settings": { "foreground": "#808080" }
    }
  ]
}
